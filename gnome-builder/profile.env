GNOME_PROFILE_VERSION=1
GNOME_TARGET_ARCH=aarch64
GNOME_RELEASEVER=rawhide
GNOME_CONTAINER_IMAGE=registry.fedoraproject.org/fedora:rawhide
GNOME_COPR_BASEURL=https://download.copr.fedorainfracloud.org/results/mcc45tr/nabu-linux/fedora-rawhide-aarch64/
GNOME_COPR_GPGKEY=https://download.copr.fedorainfracloud.org/results/mcc45tr/nabu-linux/pubkey.gpg
GNOME_FILESYSTEM=ext4
GNOME_CORE_FILESYSTEM_LABEL=linux
GNOME_ESP_LABEL=ESPNABU
GNOME_ESP_LOGICAL_SECTOR_SIZE=4096
GNOME_DEFAULT_PROFILE=minimal
GNOME_COMPRESSION_LEVEL=10

# Explicit packages keep Fedora comps/group drift from silently changing an image.
GNOME_MINIMAL_PACKAGES="gdm gnome-shell gnome-session gnome-session-wayland-session gnome-settings-daemon gnome-control-center gnome-initial-setup mutter gnome-software ptyxis nautilus NetworkManager-wifi bluez upower pipewire wireplumber gnome-keyring xdg-desktop-portal-gnome xdg-user-dirs gvfs-fuse"
GNOME_OPTIMAL_PACKAGES="firefox loupe gnome-weather gnome-clocks gnome-calculator gnome-text-editor showtime papers gnome-system-monitor nano fastfetch dconf polkit PackageKit-command-not-found PackageKit-gtk3-module glycin-thumbnailer gnome-epub-thumbnailer gst-thumbnailers gvfs-afc gvfs-goa gvfs-gphoto2 gvfs-mtp gvfs-smb librsvg2 papers-nautilus sushi"
