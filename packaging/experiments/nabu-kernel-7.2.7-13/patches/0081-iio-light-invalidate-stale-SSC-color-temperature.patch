From eebd8c32ce104b41411058919e63abe1c9e83106 Mon Sep 17 00:00:00 2001
From: mcc45tr <mcc45tr@gmail.com>
Date: Wed, 2 Sep 2026 23:38:00 +0300
Subject: [PATCH 81/81] iio: light: invalidate stale SSC color temperature

---
 drivers/iio/light/qcom-ssc-cct.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/drivers/iio/light/qcom-ssc-cct.c b/drivers/iio/light/qcom-ssc-cct.c
index f09979de6da2..91273ffd5d51 100644
--- a/drivers/iio/light/qcom-ssc-cct.c
+++ b/drivers/iio/light/qcom-ssc-cct.c
@@ -61,13 +61,13 @@ static int ssc_cct_write_raw(struct iio_dev *indio_dev,
 {
 	struct ssc_cct_state *state = iio_priv(indio_dev);
 
-	if (mask != IIO_CHAN_INFO_RAW || val2 ||
-	    val < SSC_CCT_MIN_KELVIN || val > SSC_CCT_MAX_KELVIN)
+	if (mask != IIO_CHAN_INFO_RAW || val2 || val < 0 ||
+	    (val && (val < SSC_CCT_MIN_KELVIN || val > SSC_CCT_MAX_KELVIN)))
 		return -EINVAL;
 
 	mutex_lock(&state->lock);
 	state->kelvin = val;
-	state->valid = true;
+	state->valid = val != 0;
 	mutex_unlock(&state->lock);
 	return 0;
 }
