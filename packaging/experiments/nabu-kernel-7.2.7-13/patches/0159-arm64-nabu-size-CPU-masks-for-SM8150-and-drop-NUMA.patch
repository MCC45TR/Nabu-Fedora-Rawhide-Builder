From 5ea01d35ebdd9d78c79c93922838de95fd6bdff3 Mon Sep 17 00:00:00 2001
From: mcc45tr <mcc45tr@gmail.com>
Date: Thu, 24 Sep 2026 06:55:06 +0300
Subject: [PATCH 159/161] arm64: nabu: size CPU masks for SM8150 and drop NUMA

Nabu has eight CPUs and no NUMA topology. The arm64 defconfig default of
512 CPUs and NUMA bookkeeping is unnecessary for this device-only kernel.
Keep scheduler energy model, cpufreq policies, CPU hotplug and all
physical cores.

Signed-off-by: mcc45tr <mcc45tr@gmail.com>
---
 senemos/configs/nabu-minimal.config | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/senemos/configs/nabu-minimal.config b/senemos/configs/nabu-minimal.config
index e6d277409..029faccbe 100644
--- a/senemos/configs/nabu-minimal.config
+++ b/senemos/configs/nabu-minimal.config
@@ -2,6 +2,12 @@
 CONFIG_LOCALVERSION="-nabu-senemos-mainline"
 # CONFIG_LOCALVERSION_AUTO is not set
 
+# SM8150 has eight CPUs sharing one memory node. Avoid the generic arm64
+# defconfig's 512-CPU masks and NUMA allocation/scheduler structures.
+CONFIG_NR_CPUS=8
+# CONFIG_NUMA is not set
+# CONFIG_NUMA_BALANCING is not set
+
 CONFIG_ARCH_QCOM=y
 CONFIG_PINCTRL_SM8150=y
 CONFIG_SM_GCC_8150=y
-- 
2.55.0
