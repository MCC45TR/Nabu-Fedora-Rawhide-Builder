+++ b/Documentation/devicetree/bindings/soc/qcom/xiaomi,nabu-power-profile.yaml
@@ -0,0 +1,35 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/soc/qcom/xiaomi,nabu-power-profile.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Xiaomi Pad 5 platform power-profile controller
+
+maintainers:
+  - mcc45tr <mcc45tr@gmail.com>
+
+description:
+  Coordinates the three platform-wide CPU and GPU performance profiles used
+  by the Xiaomi Pad 5 downstream power policy through Linux frequency QoS.
+
+properties:
+  compatible:
+    const: xiaomi,nabu-power-profile
+
+  xiaomi,gpu:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: Phandle to the Adreno GPU constrained by the profiles.
+
+required:
+  - compatible
+  - xiaomi,gpu
+
+additionalProperties: false
+
+examples:
+  - |
+    power-profile {
+        compatible = "xiaomi,nabu-power-profile";
+        xiaomi,gpu = <&gpu>;
+    };
