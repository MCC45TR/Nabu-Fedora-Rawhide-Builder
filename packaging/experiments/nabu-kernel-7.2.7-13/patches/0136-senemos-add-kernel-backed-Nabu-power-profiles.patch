diff --git a/drivers/soc/qcom/xiaomi-nabu-power-profile.c b/drivers/soc/qcom/xiaomi-nabu-power-profile.c
new file mode 100644
index 000000000..5bcc72417
--- /dev/null
+++ b/drivers/soc/qcom/xiaomi-nabu-power-profile.c
@@ -0,0 +1,266 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Xiaomi Pad 5 (nabu) platform power profiles
+ *
+ * The downstream Android Power HAL uses three sets of CPU and GPU ceilings.
+ * Keep those board-specific limits in one kernel policy so desktop power
+ * managers use the standard platform-profile ABI and all constraints compose
+ * with thermal cooling through the frequency QoS frameworks.
+ */
+
+#include <linux/cleanup.h>
+#include <linux/cpufreq.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/of_platform.h>
+#include <linux/platform_device.h>
+#include <linux/platform_profile.h>
+#include <linux/pm_qos.h>
+
+#define NABU_CPU_POLICY_COUNT 3
+
+struct nabu_profile_limits {
+	u32 cpu_max_khz[NABU_CPU_POLICY_COUNT];
+	u32 gpu_max_khz;
+};
+
+static const struct nabu_profile_limits nabu_profile_limits[] = {
+	[PLATFORM_PROFILE_LOW_POWER] = {
+		.cpu_max_khz = { 1555200, 2131200, 2534400 },
+		.gpu_max_khz = 585000,
+	},
+	[PLATFORM_PROFILE_BALANCED] = {
+		.cpu_max_khz = { 1785600, 2419200, 2841600 },
+		.gpu_max_khz = 675000,
+	},
+	[PLATFORM_PROFILE_PERFORMANCE] = {
+		.cpu_max_khz = { 1785600, 2419200, 2956800 },
+		.gpu_max_khz = 675000,
+	},
+};
+
+struct nabu_power_profile {
+	struct device *profile_dev;
+	struct device *gpu_dev;
+	struct cpufreq_policy *policies[NABU_CPU_POLICY_COUNT];
+	struct freq_qos_request cpu_max_requests[NABU_CPU_POLICY_COUNT];
+	struct dev_pm_qos_request gpu_max_request;
+	enum platform_profile_option active_profile;
+	struct mutex lock;
+};
+
+static const unsigned int nabu_policy_cpus[NABU_CPU_POLICY_COUNT] = { 0, 4, 7 };
+
+static bool nabu_profile_supported(enum platform_profile_option profile)
+{
+	return profile == PLATFORM_PROFILE_LOW_POWER ||
+	       profile == PLATFORM_PROFILE_BALANCED ||
+	       profile == PLATFORM_PROFILE_PERFORMANCE;
+}
+
+static int nabu_profile_choices(void *data, unsigned long *choices)
+{
+	set_bit(PLATFORM_PROFILE_LOW_POWER, choices);
+	set_bit(PLATFORM_PROFILE_BALANCED, choices);
+	set_bit(PLATFORM_PROFILE_PERFORMANCE, choices);
+
+	return 0;
+}
+
+static int nabu_profile_get(struct device *dev,
+			    enum platform_profile_option *profile)
+{
+	struct nabu_power_profile *nabu = dev_get_drvdata(dev);
+
+	guard(mutex)(&nabu->lock);
+	*profile = nabu->active_profile;
+
+	return 0;
+}
+
+static int nabu_update_profile(struct nabu_power_profile *nabu,
+			       enum platform_profile_option profile)
+{
+	const struct nabu_profile_limits *old_limits;
+	const struct nabu_profile_limits *new_limits;
+	int i, ret;
+
+	if (!nabu_profile_supported(profile))
+		return -EOPNOTSUPP;
+
+	old_limits = &nabu_profile_limits[nabu->active_profile];
+	new_limits = &nabu_profile_limits[profile];
+
+	for (i = 0; i < NABU_CPU_POLICY_COUNT; i++) {
+		ret = freq_qos_update_request(&nabu->cpu_max_requests[i],
+					      new_limits->cpu_max_khz[i]);
+		if (ret < 0)
+			goto restore_cpu;
+	}
+
+	ret = dev_pm_qos_update_request(&nabu->gpu_max_request,
+					new_limits->gpu_max_khz);
+	if (ret < 0)
+		goto restore_cpu;
+
+	nabu->active_profile = profile;
+	return 0;
+
+restore_cpu:
+	while (--i >= 0)
+		freq_qos_update_request(&nabu->cpu_max_requests[i],
+					old_limits->cpu_max_khz[i]);
+
+	return ret;
+}
+
+static int nabu_profile_set(struct device *dev,
+			    enum platform_profile_option profile)
+{
+	struct nabu_power_profile *nabu = dev_get_drvdata(dev);
+
+	guard(mutex)(&nabu->lock);
+	if (profile == nabu->active_profile)
+		return 0;
+
+	return nabu_update_profile(nabu, profile);
+}
+
+static const struct platform_profile_ops nabu_profile_ops = {
+	.probe = nabu_profile_choices,
+	.profile_get = nabu_profile_get,
+	.profile_set = nabu_profile_set,
+};
+
+static void nabu_remove_qos_requests(struct nabu_power_profile *nabu)
+{
+	int i;
+
+	if (dev_pm_qos_request_active(&nabu->gpu_max_request))
+		dev_pm_qos_remove_request(&nabu->gpu_max_request);
+
+	for (i = 0; i < NABU_CPU_POLICY_COUNT; i++) {
+		if (!nabu->policies[i])
+			continue;
+		if (freq_qos_request_active(&nabu->cpu_max_requests[i]))
+			freq_qos_remove_request(&nabu->cpu_max_requests[i]);
+		cpufreq_cpu_put(nabu->policies[i]);
+		nabu->policies[i] = NULL;
+	}
+
+	if (nabu->gpu_dev) {
+		put_device(nabu->gpu_dev);
+		nabu->gpu_dev = NULL;
+	}
+}
+
+static int nabu_add_qos_requests(struct platform_device *pdev,
+				 struct nabu_power_profile *nabu)
+{
+	const struct nabu_profile_limits *limits =
+		&nabu_profile_limits[PLATFORM_PROFILE_BALANCED];
+	struct device_node *gpu_node;
+	struct platform_device *gpu_pdev;
+	int i, ret;
+
+	for (i = 0; i < NABU_CPU_POLICY_COUNT; i++) {
+		nabu->policies[i] = cpufreq_cpu_get(nabu_policy_cpus[i]);
+		if (!nabu->policies[i]) {
+			ret = -EPROBE_DEFER;
+			goto error;
+		}
+
+		ret = freq_qos_add_request(&nabu->policies[i]->constraints,
+					   &nabu->cpu_max_requests[i],
+					   FREQ_QOS_MAX,
+					   limits->cpu_max_khz[i]);
+		if (ret < 0)
+			goto error;
+	}
+
+	gpu_node = of_parse_phandle(pdev->dev.of_node, "xiaomi,gpu", 0);
+	if (!gpu_node) {
+		ret = -EINVAL;
+		goto error;
+	}
+	gpu_pdev = of_find_device_by_node(gpu_node);
+	of_node_put(gpu_node);
+	if (!gpu_pdev) {
+		ret = -EPROBE_DEFER;
+		goto error;
+	}
+	nabu->gpu_dev = &gpu_pdev->dev;
+
+	ret = dev_pm_qos_add_request(nabu->gpu_dev, &nabu->gpu_max_request,
+				     DEV_PM_QOS_MAX_FREQUENCY,
+				     limits->gpu_max_khz);
+	if (ret < 0)
+		goto error;
+
+	return 0;
+
+error:
+	nabu_remove_qos_requests(nabu);
+	return dev_err_probe(&pdev->dev, ret,
+			     "failed to acquire frequency QoS controls\n");
+}
+
+static int nabu_power_profile_probe(struct platform_device *pdev)
+{
+	struct nabu_power_profile *nabu;
+	int ret;
+
+	nabu = devm_kzalloc(&pdev->dev, sizeof(*nabu), GFP_KERNEL);
+	if (!nabu)
+		return -ENOMEM;
+
+	mutex_init(&nabu->lock);
+	nabu->active_profile = PLATFORM_PROFILE_BALANCED;
+	platform_set_drvdata(pdev, nabu);
+
+	ret = nabu_add_qos_requests(pdev, nabu);
+	if (ret)
+		return ret;
+
+	nabu->profile_dev = platform_profile_register(&pdev->dev,
+					       "xiaomi-nabu", nabu,
+					       &nabu_profile_ops);
+	if (IS_ERR(nabu->profile_dev)) {
+		ret = PTR_ERR(nabu->profile_dev);
+		nabu->profile_dev = NULL;
+		nabu_remove_qos_requests(nabu);
+		return dev_err_probe(&pdev->dev, ret,
+				     "failed to register platform profile\n");
+	}
+
+	dev_info(&pdev->dev, "registered balanced Nabu CPU/GPU profile\n");
+	return 0;
+}
+
+static void nabu_power_profile_remove(struct platform_device *pdev)
+{
+	struct nabu_power_profile *nabu = platform_get_drvdata(pdev);
+
+	platform_profile_remove(nabu->profile_dev);
+	nabu_remove_qos_requests(nabu);
+}
+
+static const struct of_device_id nabu_power_profile_of_match[] = {
+	{ .compatible = "xiaomi,nabu-power-profile" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, nabu_power_profile_of_match);
+
+static struct platform_driver nabu_power_profile_driver = {
+	.probe = nabu_power_profile_probe,
+	.remove = nabu_power_profile_remove,
+	.driver = {
+		.name = "xiaomi-nabu-power-profile",
+		.of_match_table = nabu_power_profile_of_match,
+	},
+};
+module_platform_driver(nabu_power_profile_driver);
+
+MODULE_AUTHOR("mcc45tr <mcc45tr@gmail.com>");
+MODULE_DESCRIPTION("Xiaomi Pad 5 CPU and GPU platform profiles");
+MODULE_LICENSE("GPL");
