-    $ref: /schemas/types.yaml#/definitions/uint32-array
     minItems: 1
     maxItems: 32
+    items:
+      minimum: 0
     description:
       Descending USB input-current limits. The number of entries must match
       qcom,thermal-mitigation-microamp.
 
   qcom,thermal-mitigation-dcp-microamp:
-    $ref: /schemas/types.yaml#/definitions/uint32-array
     minItems: 1
     maxItems: 32
+    items:
+      minimum: 0
     description:
       Optional descending DCP-specific USB input-current limits. The number of
       entries must match qcom,thermal-mitigation-microamp.
 
   qcom,thermal-mitigation-pd-microamp:
-    $ref: /schemas/types.yaml#/definitions/uint32-array
     minItems: 1
     maxItems: 32
+    items:
+      minimum: 0
     description:
       Optional descending 5 V PD base input-current limits. For higher fixed
       PDO voltages the driver scales these limits to maintain a conservative
