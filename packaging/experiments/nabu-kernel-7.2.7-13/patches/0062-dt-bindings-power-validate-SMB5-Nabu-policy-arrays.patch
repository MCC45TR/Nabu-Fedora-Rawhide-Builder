@@ -32,7 +32,6 @@ properties:
 
   io-channels:
     minItems: 2
-    maxItems: 3
     items:
       - description: USB in current in uA
       - description: USB in voltage in uV
@@ -40,7 +39,6 @@ properties:
 
   io-channel-names:
     minItems: 2
-    maxItems: 3
