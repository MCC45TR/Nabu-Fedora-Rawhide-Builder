+		prtd->state = Q6ASM_STREAM_STOPPED;
+		if (substream->stream == SNDRV_PCM_STREAM_PLAYBACK) {
+			reinit_completion(&prtd->eos_done);
+			ret = q6asm_cmd_nowait(prtd->audio_client,
