From 76cf8fdf9f19ce37bfb3eb81e98860fcabe20395 Mon Sep 17 00:00:00 2001
From: mcc45tr <mcc45tr@gmail.com>
Date: Wed, 2 Sep 2026 00:07:19 +0300
Subject: [PATCH 63/64] usb: nabu: restore dual-role VBUS operation on 7.2

---
 arch/arm64/boot/dts/qcom/sm8150-xiaomi-nabu.dts | 1 +
 senemos/configs/nabu-minimal.config             | 6 ++++++
 2 files changed, 7 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8150-xiaomi-nabu.dts b/arch/arm64/boot/dts/qcom/sm8150-xiaomi-nabu.dts
index d54ad6641184..7ea310c083c8 100644
--- a/arch/arm64/boot/dts/qcom/sm8150-xiaomi-nabu.dts
+++ b/arch/arm64/boot/dts/qcom/sm8150-xiaomi-nabu.dts
@@ -816,6 +816,7 @@ &pm8150b_typec {
 
 	connector {
 		compatible = "usb-c-connector";
+		vbus-supply = <&pm8150b_vbus>;
 
 		power-role = "dual";
 		data-role = "dual";
diff --git a/senemos/configs/nabu-minimal.config b/senemos/configs/nabu-minimal.config
index 14fd31dad60c..d7b54bc020d1 100644
--- a/senemos/configs/nabu-minimal.config
+++ b/senemos/configs/nabu-minimal.config
@@ -56,9 +56,15 @@ CONFIG_USB_ACM=y
 # The primary USB-C path is boot-critical for recovery and wired input.
 CONFIG_USB_DWC3=y
 CONFIG_USB_DWC3_QCOM=y
+CONFIG_USB_GADGET=y
+CONFIG_USB_DWC3_DUAL_ROLE=y
+# CONFIG_USB_DWC3_HOST is not set
 CONFIG_TYPEC=y
 CONFIG_TYPEC_TCPM=y
 CONFIG_TYPEC_QCOM_PMIC=y
+CONFIG_TYPEC_MUX_FSA4480=y
+CONFIG_REGULATOR_QCOM_USB_VBUS=y
+CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y
 CONFIG_PHY_QCOM_QMP_USB=y
 CONFIG_PHY_QCOM_QMP_COMBO=y
 
