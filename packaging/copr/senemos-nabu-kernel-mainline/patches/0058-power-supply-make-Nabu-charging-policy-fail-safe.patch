From efc7d35a57382bcc97dcbaebbce8afb77efa7ebb Mon Sep 17 00:00:00 2001
From: mcc45tr <mcc45tr@gmail.com>
Date: Sun, 30 Aug 2026 14:07:31 +0300
Subject: [PATCH 58/64] power: supply: make Nabu charging policy fail-safe

Correct the PM8150B current and float-voltage register scales, decode the Gen4 fuel-gauge temperature in its actual signed byte format, and make charger probe and policy failures leave charging disabled.

Keep source-contract, JEITA, connector-temperature and cooling requests conservative. Require an explicit firmware opt-in before LN8000 direct charging can bypass the PMIC switching charger.

Signed-off-by: mcc45tr <mcc45tr@gmail.com>
---
 .../power/supply/lionsemi,ln8000.yaml         |   8 +
 drivers/power/supply/ln8000_charger.c         |  32 ++-
 drivers/power/supply/qcom_fg.c                |  10 +-
 drivers/power/supply/qcom_smbx.c              | 233 ++++++++++++------
 4 files changed, 196 insertions(+), 87 deletions(-)

diff --git a/Documentation/devicetree/bindings/power/supply/lionsemi,ln8000.yaml b/Documentation/devicetree/bindings/power/supply/lionsemi,ln8000.yaml
index 2b72097f083e..4ead974613b3 100644
--- a/Documentation/devicetree/bindings/power/supply/lionsemi,ln8000.yaml
+++ b/Documentation/devicetree/bindings/power/supply/lionsemi,ln8000.yaml
@@ -73,6 +73,14 @@ properties:
       This disables only that absent input while battery NTC, die-temperature,
       voltage, current, watchdog and reverse-current protections stay active.
 
+  lionsemi,allow-direct-charging:
+    type: boolean
+    description: |
+      Explicitly allows the 2:1 direct-charge path. Omit this property unless
+      the platform has a validated source-contract and battery-current policy;
+      without it the driver remains in standby and the conventional charger
+      supplies the battery.
+
 required:
   - compatible
   - reg
diff --git a/drivers/power/supply/ln8000_charger.c b/drivers/power/supply/ln8000_charger.c
index ecd5a5655f7c..6f8c977ad301 100644
--- a/drivers/power/supply/ln8000_charger.c
+++ b/drivers/power/supply/ln8000_charger.c
