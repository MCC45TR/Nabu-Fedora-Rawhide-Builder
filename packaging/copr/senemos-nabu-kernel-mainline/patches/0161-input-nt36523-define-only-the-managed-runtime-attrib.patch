From f352cf3ca132d55abb333c6e3c86098dfb17f786 Mon Sep 17 00:00:00 2001
From: mcc45tr <mcc45tr@gmail.com>
Date: Thu, 24 Sep 2026 06:55:07 +0300
Subject: [PATCH 161/161] input: nt36523: define only the managed runtime
 attribute group

The driver registers the singular group with devm_device_add_group.
Avoid the unused groups array generated by ATTRIBUTE_GROUPS without
changing the double-tap-to-wake ABI.

Signed-off-by: mcc45tr <mcc45tr@gmail.com>
---
 drivers/input/touchscreen/nt36523/nt36xxx.c | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/drivers/input/touchscreen/nt36523/nt36xxx.c b/drivers/input/touchscreen/nt36523/nt36xxx.c
index 7cf25b427..393c616b5 100644
--- a/drivers/input/touchscreen/nt36523/nt36xxx.c
+++ b/drivers/input/touchscreen/nt36523/nt36xxx.c
@@ -146,7 +146,9 @@ static struct attribute *nvt_runtime_attrs[] = {
 	&dev_attr_double_tap_to_wake.attr,
 	NULL,
 };
-ATTRIBUTE_GROUPS(nvt_runtime);
+static const struct attribute_group nvt_runtime_group = {
+	.attrs = nvt_runtime_attrs,
+};
 
