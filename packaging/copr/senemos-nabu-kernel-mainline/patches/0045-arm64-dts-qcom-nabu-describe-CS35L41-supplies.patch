+		VP-supply = <&vph_pwr>;
 		#sound-dai-cells = <1>;
 		sound-name-prefix = "TR";
 		cirrus,boost-peak-milliamp = <4000>;
@@ -569,6 +573,8 @@ cs35l41_bl: cs35l41@42 {
 		interrupt-parent = <&tlmm>;
 		interrupts = <91 IRQ_TYPE_LEVEL_LOW>;
 		reset-gpios = <&tlmm 92 GPIO_ACTIVE_HIGH>;
+		VA-supply = <&vreg_s4a_1p8>;
+		VP-supply = <&vph_pwr>;
 		#sound-dai-cells = <1>;
 		sound-name-prefix = "BL";
 		cirrus,boost-peak-milliamp = <4000>;
@@ -586,6 +592,8 @@ cs35l41_tl: cs35l41@43 {
 		interrupt-parent = <&tlmm>;
 		interrupts = <93 IRQ_TYPE_LEVEL_LOW>;
 		reset-gpios = <&tlmm 92 GPIO_ACTIVE_HIGH>;
+		VA-supply = <&vreg_s4a_1p8>;
+		VP-supply = <&vph_pwr>;
 		#sound-dai-cells = <1>;
 		sound-name-prefix = "TL";
 		cirrus,boost-peak-milliamp = <4000>;
