+			 <&camcc CAM_CC_CCI_1_CLK_SRC>;
+		clock-names = "camnoc_axi",
+			      "slow_ahb_src",
+			      "cpas_ahb",
+			      "cci",
+			      "cci_src";
+
+		pinctrl-0 = <&cci1_default>;
+		pinctrl-1 = <&cci1_sleep>;
+		pinctrl-names = "default", "sleep";
+
+		status = "disabled";
+
+		cci1_i2c0: i2c-bus@0 {
+			reg = <0>;
+			clock-frequency = <1000000>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+		};
