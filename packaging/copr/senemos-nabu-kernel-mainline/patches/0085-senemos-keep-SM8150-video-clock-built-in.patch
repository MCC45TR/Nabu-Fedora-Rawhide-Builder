From 0000000000000000000000000000000000000085 Mon Sep 17 00:00:00 2001
From: mcc45tr <mcc45tr@gmail.com>
Date: Fri, 4 Sep 2026 11:30:00 +0300
Subject: [PATCH] senemos: keep SM8150 video clock built in

Iris and the camera graph share the SM8150 video clock controller.  Keep it
available before module and userspace probing, matching the existing built-in
CCI, CAMCC and DMA-heap prerequisites.

Signed-off-by: mcc45tr <mcc45tr@gmail.com>
---
 senemos/configs/nabu-minimal.config  | 1 +
 senemos/configs/prune-nabu-config.sh | 1 +
 2 files changed, 2 insertions(+)

diff --git a/senemos/configs/nabu-minimal.config b/senemos/configs/nabu-minimal.config
--- a/senemos/configs/nabu-minimal.config
+++ b/senemos/configs/nabu-minimal.config
@@ -153,5 +153,6 @@ CONFIG_MEDIA_CAMERA_SUPPORT=y
 CONFIG_I2C_QCOM_CCI=y
 CONFIG_SM_CAMCC_8150=y
+CONFIG_SM_VIDEOCC_8150=y
 CONFIG_VIDEO_QCOM_CAMSS=m
 CONFIG_VIDEO_OV13B10=m
 CONFIG_VIDEO_OV8856=m
diff --git a/senemos/configs/prune-nabu-config.sh b/senemos/configs/prune-nabu-config.sh
--- a/senemos/configs/prune-nabu-config.sh
+++ b/senemos/configs/prune-nabu-config.sh
@@ -83,7 +83,8 @@ while IFS= read -r symbol; do
 done < <(sed -n 's/^CONFIG_\([A-Z0-9_]*\(GCC\|GPUCC\|DISPCC\|VIDEOCC\|CAMCC\|TCSRCC\)[A-Z0-9_]*\)=[ym]$/\1/p' "$config_file")
 
 "$config_tool" --file "$config_file" "${args[@]}" \
 	--enable I2C_QCOM_CCI --enable SM_CAMCC_8150 \
+	--enable SM_VIDEOCC_8150 \
 	--enable DMABUF_HEAPS --enable DMABUF_HEAPS_SYSTEM \
 	--enable DMABUF_HEAPS_CMA \
 	--enable GPIO_SHARED_PROXY \
-- 
2.55.0
