From d2fbc950b36062ea558c78965ce44d6a4f0d16aa Mon Sep 17 00:00:00 2001
From: mcc45tr <mcc45tr@gmail.com>
Date: Sun, 13 Sep 2026 10:06:25 +0300
Subject: [PATCH 147/147] senemos: recover from persistent Nabu kernel stalls

---
 senemos/configs/nabu-minimal.config | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/senemos/configs/nabu-minimal.config b/senemos/configs/nabu-minimal.config
index 87749d79c..fbe5e9964 100644
--- a/senemos/configs/nabu-minimal.config
+++ b/senemos/configs/nabu-minimal.config
@@ -179,6 +179,17 @@ CONFIG_PM_SLEEP_DEBUG=y
 CONFIG_DPM_WATCHDOG=y
 CONFIG_DPM_WATCHDOG_TIMEOUT=30
 CONFIG_DPM_WATCHDOG_WARNING_TIMEOUT=10
+# Preserve evidence and recover automatically if a storage fault leaves tasks
+# blocked indefinitely. The workqueue watchdog remains diagnostic; only a
+# confirmed 120-second uninterruptible task stall triggers the pstore-backed
+# panic/reboot path.
+CONFIG_DETECT_HUNG_TASK=y
+CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=120
+CONFIG_BOOTPARAM_HUNG_TASK_PANIC=1
+CONFIG_DETECT_HUNG_TASK_BLOCKER=y
+CONFIG_WQ_WATCHDOG=y
+CONFIG_BOOTPARAM_WQ_STALL_PANIC=0
+CONFIG_PANIC_TIMEOUT=15
 CONFIG_FTRACE=y
 CONFIG_FUNCTION_TRACER=y
 CONFIG_FUNCTION_GRAPH_TRACER=y
-- 
2.55.0

