+static void iris_vdec_reset_rate_window(struct iris_inst *inst)
+{
+	inst->last_buf_ns = 0;
+	inst->rate_min_timestamp = 0;
+	inst->rate_max_timestamp = 0;
+	inst->frame_counter = 0;
