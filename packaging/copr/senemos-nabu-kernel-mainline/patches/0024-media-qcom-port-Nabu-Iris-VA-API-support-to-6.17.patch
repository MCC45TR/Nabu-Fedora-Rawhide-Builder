+	list_add_tail(&surface_fence->list, &inst->surface_fences);
+	dma_buf_put(dmabuf);
+	return 0;
+
+put_fence:
+	dma_fence_put(&surface_fence->base);
+put_dmabuf:
+	dma_buf_put(dmabuf);
+	return ret;
+}
