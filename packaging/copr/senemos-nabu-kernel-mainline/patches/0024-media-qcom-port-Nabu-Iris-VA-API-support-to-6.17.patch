+	list_for_each_entry(surface_fence, &inst->surface_fences, list) {
+		if (surface_fence->token != token)
+			continue;
+		list_del(&surface_fence->list);
+		iris_surface_fence_complete(surface_fence);
+		return 0;
+	}
+
+	return -ENOENT;
+}
