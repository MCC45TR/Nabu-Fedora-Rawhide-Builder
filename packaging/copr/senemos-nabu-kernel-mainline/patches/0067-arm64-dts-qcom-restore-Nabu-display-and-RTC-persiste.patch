From 18a4294d74e4fda08158cd74903447d94aac68d8 Mon Sep 17 00:00:00 2001
From: mcc45tr <mcc45tr@gmail.com>
Date: Wed, 2 Sep 2026 13:01:04 +0300
Subject: [PATCH] arm64: dts: qcom: restore Nabu display and RTC persistence

---
 arch/arm64/boot/dts/qcom/pm8150.dtsi            | 2 +-
 arch/arm64/boot/dts/qcom/sm8150-xiaomi-nabu.dts | 5 +++++
 senemos/configs/nabu-minimal.config             | 1 +
 3 files changed, 7 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/qcom/pm8150.dtsi b/arch/arm64/boot/dts/qcom/pm8150.dtsi
index a74a7ff660d2..34758acbcd96 100644
--- a/arch/arm64/boot/dts/qcom/pm8150.dtsi
+++ b/arch/arm64/boot/dts/qcom/pm8150.dtsi
@@ -118,7 +118,7 @@ pm8150_adc_tm: adc-tm@3500 {
 			status = "disabled";
 		};
 
-		rtc@6000 {
+		pm8150_rtc: rtc@6000 {
 			compatible = "qcom,pm8941-rtc";
 			reg = <0x6000>, <0x6100>;
 			reg-names = "rtc", "alarm";
diff --git a/arch/arm64/boot/dts/qcom/sm8150-xiaomi-nabu.dts b/arch/arm64/boot/dts/qcom/sm8150-xiaomi-nabu.dts
index 7ea310c083c8..2e0fb1e2e934 100644
--- a/arch/arm64/boot/dts/qcom/sm8150-xiaomi-nabu.dts
+++ b/arch/arm64/boot/dts/qcom/sm8150-xiaomi-nabu.dts
@@ -718,6 +718,11 @@ vol_up_n: vol-up-n-state {
 	};
 };
 
+&pm8150_rtc {
+	/* Nabu has no firmware-backed wall clock; let Linux persist NTP time. */
+	allow-set-time;
+};
+
 &pm8150b_adc {
 	channel@4f {
 		reg = <ADC5_AMUX_THM3_100K_PU>;
diff --git a/senemos/configs/nabu-minimal.config b/senemos/configs/nabu-minimal.config
index 98209e1f8cc4..ea7b2f35e96a 100644
--- a/senemos/configs/nabu-minimal.config
+++ b/senemos/configs/nabu-minimal.config
@@ -11,6 +11,7 @@ CONFIG_INTERCONNECT_QCOM_SM8150=y
 CONFIG_QCOM_LLCC=y
 CONFIG_QCOM_RPMH=y
 CONFIG_REGULATOR_QCOM_RPMH=y
+CONFIG_REGULATOR_QCOM_REFGEN=y
 
 # Keep UFS and its PHY available before the root filesystem is mounted.
 CONFIG_SCSI=y
-- 
2.55.0

