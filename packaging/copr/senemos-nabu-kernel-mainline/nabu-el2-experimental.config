# Upstream KVM host support, not an EL1 -> EL2 transition mechanism.
# No kvm-arm.mode override: let ARM64 select VHE/nVHE from real firmware entry.
CONFIG_LOCALVERSION="-nabu-senemos-el2-experimental"
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=y
# CONFIG_NVHE_EL2_DEBUG is not set
# CONFIG_NVHE_EL2_TRACING is not set
# CONFIG_PTDUMP_STAGE2_DEBUGFS is not set
# CONFIG_PKVM_DISABLE_STAGE2_ON_PANIC is not set
