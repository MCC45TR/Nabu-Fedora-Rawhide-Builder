From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mcc45tr <mcc45tr@gmail.com>
Date: Mon, 7 Sep 2026 21:53:56 +0300
Subject: [PATCH 112/117] arm64: dts: qcom: expose Nabu camera calibration
 EEPROMs

---
 .../dts/qcom/sm8150-xiaomi-nabu-camera.dtsi   | 20 +++++++++++++++----
 senemos/configs/nabu-minimal.config           |  1 +
 2 files changed, 17 insertions(+), 4 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/sm8150-xiaomi-nabu-camera.dtsi b/arch/arm64/boot/dts/qcom/sm8150-xiaomi-nabu-camera.dtsi
index eef717da69d8..d90df006d94c 100644
--- a/arch/arm64/boot/dts/qcom/sm8150-xiaomi-nabu-camera.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm8150-xiaomi-nabu-camera.dtsi
@@ -404,10 +404,6 @@ port@3 {
 	};
 };
 
-&camcc {
-	power-domains = <&rpmhpd SM8150_MMCX>, <&rpmhpd SM8150_MX>;
-};
-
 &camss {
 	vdda-phy-supply = <&vreg_l5a_0p8>;
 	vdda-pll-supply = <&vreg_l3c_1p2>;
@@ -438,6 +434,14 @@ &cci0 {
 };
 
 &cci0_i2c0 {
+	rear_camera_eeprom: eeprom@51 {
+		compatible = "belling,bl24sa64", "atmel,24c64";
+		reg = <0x51>;
+		label = "nabu-rear-camera-calibration";
+		vcc-supply = <&vreg_l1c_1p8>;
+		read-only;
+	};
+
 	ov13b10: camera@10 {
 		compatible = "ovti,ov13b10";
 		reg = <0x10>;
@@ -478,6 +482,14 @@ cn3927: lens@c {
 };
 
 &cci0_i2c1 {
+	front_camera_eeprom: eeprom@50 {
+		compatible = "puya,p24c64f", "atmel,24c64";
+		reg = <0x50>;
+		label = "nabu-front-camera-calibration";
+		vcc-supply = <&vreg_l1c_1p8>;
+		read-only;
+	};
+
 	ov8856: camera@10 {
 		compatible = "ovti,ov8856";
 		reg = <0x10>;
diff --git a/senemos/configs/nabu-minimal.config b/senemos/configs/nabu-minimal.config
index 1ae2e198f151..998090161003 100644
--- a/senemos/configs/nabu-minimal.config
+++ b/senemos/configs/nabu-minimal.config
@@ -194,6 +194,7 @@ CONFIG_RTC_HCTOSYS_DEVICE="rtc0"
 # Nabu front/rear cameras, CAMSS/CCI and CN3927 autofocus.
 CONFIG_MEDIA_CAMERA_SUPPORT=y
 CONFIG_I2C_QCOM_CCI=y
+CONFIG_EEPROM_AT24=m
 CONFIG_SM_CAMCC_8150=y
 CONFIG_SM_VIDEOCC_8150=y
 CONFIG_VIDEO_QCOM_CAMSS=m
