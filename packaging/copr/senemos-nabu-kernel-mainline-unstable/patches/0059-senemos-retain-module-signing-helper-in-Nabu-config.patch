From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mcc45tr <mcc45tr@gmail.com>
Date: Wed, 2 Sep 2026 10:36:53 +0300
Subject: [PATCH 059/117] senemos: retain module signing helper in Nabu config

---
 senemos/configs/nabu-minimal.config | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/senemos/configs/nabu-minimal.config b/senemos/configs/nabu-minimal.config
index 33b75af74fe6..b40c3f9b8cce 100644
--- a/senemos/configs/nabu-minimal.config
+++ b/senemos/configs/nabu-minimal.config
@@ -125,6 +125,11 @@ CONFIG_CMA_SIZE_MBYTES=256
 # Fedora-compatible module packaging.
 CONFIG_MODULES=y
 CONFIG_MODULE_COMPRESS_ZSTD=y
+# The RPM installation stage signs every installed module explicitly.  Keep
+# the kernel signing helper available without signing twice during make.
+CONFIG_MODULE_SIG=y
+# CONFIG_MODULE_SIG_ALL is not set
+CONFIG_MODULE_SIG_SHA512=y
 
 # Release images do not ship kernel self-tests or KUnit test modules.
 # CONFIG_RUNTIME_TESTING_MENU is not set
