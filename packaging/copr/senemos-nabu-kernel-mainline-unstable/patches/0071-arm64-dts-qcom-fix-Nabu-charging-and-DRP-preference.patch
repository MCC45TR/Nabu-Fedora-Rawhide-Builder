From d9ffa7e60cbe8920a0133b67c07d81d77f6862bd Mon Sep 17 00:00:00 2001
From: mcc45tr <mcc45tr@gmail.com>
Date: Wed, 2 Sep 2026 14:19:37 +0300
Subject: [PATCH] arm64: dts: qcom: fix Nabu charging and DRP preference

---
 arch/arm64/boot/dts/qcom/sm8150-xiaomi-nabu.dts | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8150-xiaomi-nabu.dts b/arch/arm64/boot/dts/qcom/sm8150-xiaomi-nabu.dts
index 2e0fb1e2e934..048cadfb19b6 100644
--- a/arch/arm64/boot/dts/qcom/sm8150-xiaomi-nabu.dts
+++ b/arch/arm64/boot/dts/qcom/sm8150-xiaomi-nabu.dts
@@ -726,8 +726,11 @@ &pm8150_rtc {
 &pm8150b_adc {
 	channel@4f {
 		reg = <ADC5_AMUX_THM3_100K_PU>;
+		qcom,ratiometric;
+		qcom,hw-settle-time = <200>;
 		qcom,pre-scaling = <1 1>;
 		label = "conn_therm";
+		status = "okay";
 	};
 };
 
@@ -824,6 +827,7 @@ connector {
 		vbus-supply = <&pm8150b_vbus>;
 
 		power-role = "dual";
+		try-power-role = "sink";
 		data-role = "dual";
 		self-powered;
 
-- 
2.55.0

