@@ -0,0 +1,78 @@
+# SPDX-License-Identifier: (GPL-2.0 OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/qcom,sm8150-iris.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Qualcomm SM8150 Iris video encode and decode accelerator
+
+maintainers:
+  - mcc45tr <mcc45tr@gmail.com>
+
+description:
+  The SM8150 VIDEO.IR.1.2 block uses the HFI Gen1 protocol and the legacy
+  VPU5 register layout. It contains two video processing cores.
+
+allOf:
+  - $ref: qcom,venus-common.yaml#
+
+properties:
+  compatible:
+    const: qcom,sm8150-iris
+
+  clocks:
+    maxItems: 7
+
+  clock-names:
+    items:
+      - const: core
+      - const: iface
+      - const: bus
+      - const: vcodec0_core
+      - const: vcodec0_bus
+      - const: vcodec1_core
+      - const: vcodec1_bus
+
+  interconnects:
+    maxItems: 2
+
+  interconnect-names:
+    items:
+      - const: video-mem
+      - const: cpu-cfg
+
+  operating-points-v2: true
+  opp-table:
+    type: object
+
+  power-domains:
+    maxItems: 4
+
+  power-domain-names:
+    items:
+      - const: venus
+      - const: vcodec0
+      - const: vcodec1
+      - const: cx
+
+  resets:
+    maxItems: 4
+
+  reset-names:
+    items:
+      - const: bus
+      - const: core
+      - const: vcodec0_bus
+      - const: vcodec1_bus
+
+required:
+  - compatible
+  - interconnects
+  - interconnect-names
+  - iommus
+  - operating-points-v2
+  - power-domain-names
+  - resets
+  - reset-names
+
+unevaluatedProperties: false
