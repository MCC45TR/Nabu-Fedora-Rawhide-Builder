Subject: [PATCH] HID: enable UHID for Bluetooth LE input devices

---
 senemos/configs/nabu-minimal.config | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/senemos/configs/nabu-minimal.config b/senemos/configs/nabu-minimal.config
index f04bc5d28ef4..c8f794b9e382 100644
--- a/senemos/configs/nabu-minimal.config
+++ b/senemos/configs/nabu-minimal.config
@@ -100,2 +100,5 @@ CONFIG_BT_BNEP=m
 CONFIG_BT_BNEP_MC_FILTER=y
 CONFIG_BT_BNEP_PROTO_FILTER=y
+CONFIG_HID_SUPPORT=y
+CONFIG_HID=y
+CONFIG_UHID=y
