+		case HFI_BUFFER_INTERNAL_SCRATCH_1:
+			buffer_type = BUF_SCRATCH_1;
+			break;
+		case HFI_BUFFER_INTERNAL_SCRATCH_2:
+			buffer_type = BUF_SCRATCH_2;
+			break;
+		default:
+			continue;
+		}
+
+		inst->fw_buffer_sizes[buffer_type] =
+			max(inst->fw_buffer_sizes[buffer_type], req->size);
+	}
