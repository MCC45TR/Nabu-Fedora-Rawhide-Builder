+static int iris_hfi_gen1_syscache_config(struct iris_core *core)
+{
+	static const u32 usecase_ids[] = { LLCC_VIDSC0, LLCC_VIDSC1 };
+	struct hfi_sys_set_resource_pkt *pkt;
+	u32 packet_size, i;
+	int ret;
+
