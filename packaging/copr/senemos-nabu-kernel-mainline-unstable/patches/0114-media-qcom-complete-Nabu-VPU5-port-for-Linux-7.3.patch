+	if (pkt->num_properties != 1 ||
+	    pkt->property != HFI_PROPERTY_CONFIG_BUFFER_REQUIREMENTS ||
+	    !req_bytes || req_bytes % sizeof(*req)) {
+		dev_err(inst->core->dev, "malformed VPU5 buffer requirements response\n");
+		complete(&inst->completion);
+		return;
