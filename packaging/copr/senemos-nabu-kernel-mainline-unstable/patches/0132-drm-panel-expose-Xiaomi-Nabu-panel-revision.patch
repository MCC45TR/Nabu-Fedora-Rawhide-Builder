From 96dacca137728a80e8969d66a23f1adbb20ffe25 Mon Sep 17 00:00:00 2001
From: mcc45tr <mcc45tr@gmail.com>
Date: Mon, 7 Sep 2026 21:53:55 +0300
Subject: [PATCH 3/5] drm/panel: expose Xiaomi Nabu panel revision

---
 .../sysfs-driver-panel-novatek-nt36523        |  10 ++
 drivers/gpu/drm/panel/panel-novatek-nt36523.c | 109 ++++++++++++++++++
 2 files changed, 119 insertions(+)
 create mode 100644 Documentation/ABI/testing/sysfs-driver-panel-novatek-nt36523

diff --git a/Documentation/ABI/testing/sysfs-driver-panel-novatek-nt36523 b/Documentation/ABI/testing/sysfs-driver-panel-novatek-nt36523
new file mode 100644
index 000000000000..2352523ecfe0
--- /dev/null
+++ b/Documentation/ABI/testing/sysfs-driver-panel-novatek-nt36523
@@ -0,0 +1,10 @@
+What:		/sys/bus/mipi-dsi/devices/*/panel_revision
+Date:		September 2026
+Contact:	mcc45tr <mcc45tr@gmail.com>
+Description:
+		Read-only hardware revision of the internal display module on
+		Xiaomi Pad 5 (nabu). The value is detected from the panel lockdown
+		discriminator used by Xiaomi's downstream display and touchscreen
+		drivers. Possible values are "36-02-0b", "42-02-0a", and
+		"unknown". The attribute is present only for the Nabu panel.
+Users:		SENEMOS Nabu display color-profile integration
diff --git a/drivers/gpu/drm/panel/panel-novatek-nt36523.c b/drivers/gpu/drm/panel/panel-novatek-nt36523.c
index 07ae4f00e097..7780d165d57f 100644
--- a/drivers/gpu/drm/panel/panel-novatek-nt36523.c
+++ b/drivers/gpu/drm/panel/panel-novatek-nt36523.c
@@ -12,6 +12,7 @@
 #include <linux/of.h>
 #include <linux/of_graph.h>
 #include <linux/regulator/consumer.h>
+#include <linux/sysfs.h>
 
 #include <video/mipi_display.h>
 
@@ -28,6 +29,12 @@ module_param(expose_nabu_90hz, bool, 0444);
 MODULE_PARM_DESC(expose_nabu_90hz,
 		 "Expose Xiaomi Nabu experimental 90 Hz mode");
 
+enum nabu_panel_revision {
+	NABU_PANEL_REVISION_UNKNOWN,
+	NABU_PANEL_REVISION_36_02_0B,
+	NABU_PANEL_REVISION_42_02_0A,
+};
+
 struct panel_info {
 	struct drm_panel panel;
 	struct mipi_dsi_device *dsi[2];
@@ -38,6 +45,8 @@ struct panel_info {
 	struct backlight_device *backlight;
 	struct regulator *vddio;
 	unsigned int refresh_rate;
+	enum nabu_panel_revision nabu_revision;
+	bool nabu_revision_read;
 };
 
 struct panel_desc {
@@ -64,6 +73,37 @@ static inline struct panel_info *to_panel_info(struct drm_panel *panel)
 	return container_of(panel, struct panel_info, panel);
 }
 
+static const char *nt36523_nabu_revision_name(enum nabu_panel_revision revision)
+{
+	switch (revision) {
+	case NABU_PANEL_REVISION_36_02_0B:
+		return "36-02-0b";
+	case NABU_PANEL_REVISION_42_02_0A:
+		return "42-02-0a";
+	default:
+		return "unknown";
+	}
+}
+
+static ssize_t panel_revision_show(struct device *dev,
+				   struct device_attribute *attr, char *buf)
+{
+	struct panel_info *pinfo = dev_get_drvdata(dev);
+
+	return sysfs_emit(buf, "%s\n",
+			  nt36523_nabu_revision_name(pinfo->nabu_revision));
+}
+static DEVICE_ATTR_RO(panel_revision);
+
+static struct attribute *nt36523_nabu_attrs[] = {
+	&dev_attr_panel_revision.attr,
+	NULL,
+};
+
+static const struct attribute_group nt36523_nabu_attr_group = {
+	.attrs = nt36523_nabu_attrs,
+};
+
 static int elish_boe_init_sequence(struct panel_info *pinfo)
 {
 	struct mipi_dsi_device *dsi0 = pinfo->dsi[0];
@@ -1257,6 +1297,61 @@ static void nt36523_reset(struct panel_info *pinfo)
 	usleep_range(12000, 13000);
 }
 
+static int nt36523_read_nabu_panel_revision(struct panel_info *pinfo)
+{
+	struct mipi_dsi_device *dsi0 = pinfo->dsi[0];
+	struct mipi_dsi_device *dsi1 = pinfo->dsi[1];
+	struct mipi_dsi_multi_context select_ctx = { .dsi = NULL };
+	struct mipi_dsi_multi_context restore_ctx = { .dsi = NULL };
+	u8 lockdown_display;
+	int ret;
+
+	/*
+	 * Xiaomi's two Nabu panel variants expose an eight-byte lockdown block
+	 * on vendor page 0x22. Downstream reads registers 0x01 through 0x08 and
+	 * selects the panel from lockdown[1], i.e. register 0x02. Read only that
+	 * non-unique discriminator and restore the normal command page.
+	 */
+	mipi_dsi_dual_dcs_write_seq_multi(&select_ctx, dsi0, dsi1, 0xff, 0x22);
+	if (select_ctx.accum_err) {
+		ret = select_ctx.accum_err;
+		goto restore_page;
+	}
+
+	ret = mipi_dsi_dcs_read(dsi0, 0x02, &lockdown_display,
+				sizeof(lockdown_display));
+	if (ret != sizeof(lockdown_display)) {
+		if (ret >= 0)
+			ret = -EIO;
+		goto restore_page;
+	}
+
+	switch (lockdown_display) {
+	case 0x36:
+		pinfo->nabu_revision = NABU_PANEL_REVISION_36_02_0B;
+		break;
+	case 0x42:
+		pinfo->nabu_revision = NABU_PANEL_REVISION_42_02_0A;
+		break;
+	default:
+		pinfo->nabu_revision = NABU_PANEL_REVISION_UNKNOWN;
+		ret = -ENODEV;
+		goto restore_page;
+	}
+	ret = 0;
+
+restore_page:
+	mipi_dsi_dual_dcs_write_seq_multi(&restore_ctx, dsi0, dsi1, 0xff, 0x10);
+	if (!ret && restore_ctx.accum_err)
+		ret = restore_ctx.accum_err;
+
+	if (!ret)
+		dev_info(pinfo->panel.dev, "detected Nabu panel revision %s\n",
+			 nt36523_nabu_revision_name(pinfo->nabu_revision));
+
+	return ret;
+}
+
 static int nt36523_sync_pen_fps(struct panel_info *pinfo, bool panel_init)
 {
 	struct mipi_dsi_device *dsi0 = pinfo->dsi[0];
@@ -1353,6 +1448,14 @@ static int nt36523_prepare(struct drm_panel *panel)
 		return ret;
 	}
 
+	if (pinfo->desc == &nabu_csot_desc && !pinfo->nabu_revision_read) {
+		pinfo->nabu_revision_read = true;
+		ret = nt36523_read_nabu_panel_revision(pinfo);
+		if (ret < 0)
+			dev_warn(panel->dev,
+				 "could not identify Nabu panel revision: %d\n", ret);
+	}
+
 	if (pinfo->desc->sync_pen_fps) {
 		ret = nt36523_sync_pen_fps(pinfo, true);
 		if (ret < 0) {
@@ -1567,6 +1670,12 @@ static int nt36523_probe(struct mipi_dsi_device *dsi)
 
 	pinfo->dsi[0] = dsi;
 	mipi_dsi_set_drvdata(dsi, pinfo);
+	if (pinfo->desc == &nabu_csot_desc) {
+		ret = devm_device_add_group(dev, &nt36523_nabu_attr_group);
+		if (ret)
+			return dev_err_probe(dev, ret,
+					     "failed to add Nabu panel attributes\n");
+	}
 
 	ret = of_drm_get_panel_orientation(dev->of_node, &pinfo->orientation);
 	if (ret < 0) {
