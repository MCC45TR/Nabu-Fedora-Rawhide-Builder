Subject: [PATCH 41/64] dt-bindings: sound: cs35l41: allow verified missing
 PDN_DONE

---
 .../devicetree/bindings/sound/cirrus,cs35l41.yaml      | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/Documentation/devicetree/bindings/sound/cirrus,cs35l41.yaml b/Documentation/devicetree/bindings/sound/cirrus,cs35l41.yaml
index e6cf2ebcd777..4f9d08f079b8 100644
--- a/Documentation/devicetree/bindings/sound/cirrus,cs35l41.yaml
+++ b/Documentation/devicetree/bindings/sound/cirrus,cs35l41.yaml
@@ -99,6 +99,16 @@ properties:
     minimum: 0
     maximum: 3
 
+  cirrus,allow-missing-pdn-done:
+    description:
+      Allow a platform to complete amplifier power-down when the internal boost
+      PDN_DONE interrupt status does not assert before the timeout. The driver
+      only accepts the timeout after verifying that GLOBAL_EN and AMP_EN are
+      clear and that no amplifier, temperature, or boost protection fault is
+      reported. This is intended only for platforms whose vendor driver also
+      tolerates the missing status indication.
+    type: boolean
+
