From 36d93848e906cc13d901bb00201da88bb689a50b Mon Sep 17 00:00:00 2001
From: mcc45tr <mcc45tr@gmail.com>
Date: Sat, 5 Sep 2026 12:02:15 +0300
Subject: [PATCH] Input: derive Nabu computer mode from real pogo activity

---
 .../testing/sysfs-driver-xiaomi-nabu-keyboard |  5 +-
 drivers/hid/hid-xiaomi.c                      | 23 +++++++++
 drivers/input/misc/xiaomi-nabu-keyboard.c     | 49 +++++++++++++------
 include/linux/input/xiaomi-nabu-keyboard.h    |  6 +++
 4 files changed, 65 insertions(+), 18 deletions(-)

diff --git a/Documentation/ABI/testing/sysfs-driver-xiaomi-nabu-keyboard b/Documentation/ABI/testing/sysfs-driver-xiaomi-nabu-keyboard
index 29b1e8c43814..60a748ff4418 100644
--- a/Documentation/ABI/testing/sysfs-driver-xiaomi-nabu-keyboard
+++ b/Documentation/ABI/testing/sysfs-driver-xiaomi-nabu-keyboard
@@ -2,8 +2,9 @@ What:		/sys/bus/platform/drivers/xiaomi-nabu-keyboard/*/connected
 Date:		August 2026
 Contact:	MCC45TR <mcc45tr@users.noreply.github.com>
 Description:
-		Read-only physical keyboard-cover presence. The value is 1 when
-		the active-low pogo-cover detect GPIO is asserted and 0 otherwise.
+		Read-only usable keyboard-cover presence. The value becomes 1 after
+		a real keyboard or touchpad input report arrives over the pogo HID
+		controller, and returns to 0 when the controller signals a change.
 
 What:		/sys/bus/platform/drivers/xiaomi-nabu-keyboard/*/computer_mode
 Date:		August 2026
diff --git a/drivers/hid/hid-xiaomi.c b/drivers/hid/hid-xiaomi.c
index 615163721e34..5e29a1806915 100644
--- a/drivers/hid/hid-xiaomi.c
+++ b/drivers/hid/hid-xiaomi.c
@@ -8,6 +8,7 @@
 #include <linux/init.h>
 #include <linux/module.h>
 #include <linux/hid.h>
+#include <linux/input/xiaomi-nabu-keyboard.h>
 
 #include "hid-ids.h"
 
@@ -87,6 +88,27 @@ static int xiaomi_input_configured(struct hid_device *hdev,
 	return 0;
 }
 
+static int xiaomi_raw_event(struct hid_device *hdev, struct hid_report *report,
+			    u8 *data, int size)
+{
+	int i;
+
+	if (hdev->vendor != USB_VENDOR_ID_NANO_IC ||
+	    hdev->product != USB_DEVICE_ID_XIAOMI_NABU_KEYBOARD ||
+	    report->type != HID_INPUT_REPORT || size < 2 ||
+	    (data[0] != 0x05 && data[0] != 0x19))
+		return 0;
+
+	for (i = 1; i < size; i++) {
+		if (data[i]) {
+			xiaomi_nabu_keyboard_report_activity();
+			break;
+		}
+	}
+
+	return 0;
+}
+
 static const struct hid_device_id xiaomi_devices[] = {
 	{ HID_BLUETOOTH_DEVICE(USB_VENDOR_ID_XIAOMI, USB_DEVICE_ID_MI_SILENT_MOUSE) },
 	{ HID_USB_DEVICE(USB_VENDOR_ID_NANO_IC,
@@ -100,6 +122,7 @@ static struct hid_driver xiaomi_driver = {
 	.id_table = xiaomi_devices,
 	.report_fixup = xiaomi_report_fixup,
 	.input_configured = xiaomi_input_configured,
+	.raw_event = xiaomi_raw_event,
 };
 module_hid_driver(xiaomi_driver);
 
diff --git a/drivers/input/misc/xiaomi-nabu-keyboard.c b/drivers/input/misc/xiaomi-nabu-keyboard.c
index eaac797dbbda..147f9a216a69 100644
--- a/drivers/input/misc/xiaomi-nabu-keyboard.c
+++ b/drivers/input/misc/xiaomi-nabu-keyboard.c
@@ -9,6 +9,7 @@
 #include <linux/of.h>
 #include <linux/platform_device.h>
 #include <linux/pm_wakeup.h>
+#include <linux/rcupdate.h>
 #include <linux/workqueue.h>
 
 #include <linux/input/xiaomi-nabu-keyboard.h>
@@ -21,6 +22,7 @@ struct nabu_keyboard {
 	struct gpio_desc *reset;
 	struct gpio_desc *detect;
 	struct delayed_work detect_work;
+	struct work_struct activity_work;
 	struct mutex lock;
 	int irq;
 	bool connected;
@@ -28,6 +30,8 @@ struct nabu_keyboard {
 	bool wake_enabled;
 };
 
+static struct nabu_keyboard __rcu *nabu_keyboard_controller;
+
 static void nabu_keyboard_publish_state(struct nabu_keyboard *keyboard,
 					bool connected, bool force)
 {
@@ -63,21 +67,35 @@ static void nabu_keyboard_publish_state(struct nabu_keyboard *keyboard,
 static void nabu_keyboard_detect_work(struct work_struct *work)
 {
 	struct nabu_keyboard *keyboard;
-	int value;
 
 	keyboard = container_of(to_delayed_work(work), struct nabu_keyboard,
 				detect_work);
-	value = gpiod_get_value_cansleep(keyboard->detect);
-	if (value < 0) {
-		dev_err_ratelimited(keyboard->dev,
-				    "failed to read keyboard detect GPIO: %d\n",
-				    value);
-		return;
-	}
+	nabu_keyboard_publish_state(keyboard, false, false);
+}
 
-	nabu_keyboard_publish_state(keyboard, value, false);
+static void nabu_keyboard_activity_work(struct work_struct *work)
+{
+	struct nabu_keyboard *keyboard;
+
+	keyboard = container_of(work, struct nabu_keyboard, activity_work);
+	mutex_lock(&keyboard->lock);
+	keyboard->computer_mode = true;
+	mutex_unlock(&keyboard->lock);
+	nabu_keyboard_publish_state(keyboard, true, true);
 }
 
+void xiaomi_nabu_keyboard_report_activity(void)
+{
+	struct nabu_keyboard *keyboard;
+
+	rcu_read_lock();
+	keyboard = rcu_dereference(nabu_keyboard_controller);
+	if (keyboard)
+		queue_work(system_percpu_wq, &keyboard->activity_work);
+	rcu_read_unlock();
+}
+EXPORT_SYMBOL_GPL(xiaomi_nabu_keyboard_report_activity);
+
 static irqreturn_t nabu_keyboard_detect_irq(int irq, void *data)
 {
 	struct nabu_keyboard *keyboard = data;
@@ -172,7 +190,6 @@ static int nabu_keyboard_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
 	struct nabu_keyboard *keyboard;
-	int connected;
 	int ret;
 
 	keyboard = devm_kzalloc(dev, sizeof(*keyboard), GFP_KERNEL);
@@ -198,6 +215,7 @@ static int nabu_keyboard_probe(struct platform_device *pdev)
 
 	platform_set_drvdata(pdev, keyboard);
 	INIT_DELAYED_WORK(&keyboard->detect_work, nabu_keyboard_detect_work);
+	INIT_WORK(&keyboard->activity_work, nabu_keyboard_activity_work);
 
 	/* Power the internal USB controller and release its active-low reset. */
 	gpiod_set_value_cansleep(keyboard->vdd, 1);
@@ -221,12 +239,8 @@ static int nabu_keyboard_probe(struct platform_device *pdev)
 
 	device_init_wakeup(dev,
 			   of_property_read_bool(dev->of_node, "wakeup-source"));
-	connected = gpiod_get_value_cansleep(keyboard->detect);
-	if (connected < 0) {
-		ret = connected;
-		goto err_power_off;
-	}
-	nabu_keyboard_publish_state(keyboard, connected, true);
+	nabu_keyboard_publish_state(keyboard, false, true);
+	rcu_assign_pointer(nabu_keyboard_controller, keyboard);
 
 	return 0;
 
@@ -240,7 +254,10 @@ static void nabu_keyboard_remove(struct platform_device *pdev)
 {
 	struct nabu_keyboard *keyboard = platform_get_drvdata(pdev);
 
+	rcu_assign_pointer(nabu_keyboard_controller, NULL);
+	synchronize_rcu();
 	cancel_delayed_work_sync(&keyboard->detect_work);
+	cancel_work_sync(&keyboard->activity_work);
 	nabu_keyboard_publish_state(keyboard, false, true);
 	gpiod_set_value_cansleep(keyboard->reset, 1);
 	gpiod_set_value_cansleep(keyboard->vdd, 0);
diff --git a/include/linux/input/xiaomi-nabu-keyboard.h b/include/linux/input/xiaomi-nabu-keyboard.h
index 49b39a8fbcee..c10074e755de 100644
--- a/include/linux/input/xiaomi-nabu-keyboard.h
+++ b/include/linux/input/xiaomi-nabu-keyboard.h
@@ -11,4 +11,10 @@ static inline void xiaomi_nabu_keyboard_update_mode(bool attached,
 					     bool computer_mode) { }
 #endif
 
+#if IS_REACHABLE(CONFIG_INPUT_XIAOMI_NABU_KEYBOARD)
+void xiaomi_nabu_keyboard_report_activity(void);
+#else
+static inline void xiaomi_nabu_keyboard_report_activity(void) { }
+#endif
+
 #endif
-- 
2.55.0

