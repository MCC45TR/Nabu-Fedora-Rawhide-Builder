def read_text(path: str) -> str | None:
    try:
        return open(path, encoding="utf-8").read().strip()
    except (OSError, UnicodeError):
        return None


def uptime(language: str) -> str:
    raw = read_text("/proc/uptime")
    seconds = max(0, int(float(raw.split()[0]))) if raw else 0
    divisors = (365 * 86400, 30 * 86400, 86400, 3600, 60, 1)
    values = []
    for divisor in divisors:
        value, seconds = divmod(seconds, divisor)
        values.append(value)
    units = TEXT[language][0]
    first = next((i for i, value in enumerate(values) if value), len(values) - 1)
    return " ".join(f"{values[i]} {units[i]}" for i in range(first, len(values)))


def installation_age(language: str) -> str:
    try:
        birth = int(subprocess.check_output(
            ("stat", "-c", "%W", "/"), text=True, stderr=subprocess.DEVNULL
        ).strip())
    except (OSError, subprocess.SubprocessError, ValueError):
        birth = 0
    if birth <= 0:
        try:
            birth = int(os.stat("/etc/machine-id").st_mtime)
        except OSError:
            return "—"
    days = max(0, int((time.time() - birth) // 86400))
    day = TEXT[language][0][2]
    ago = TEXT[language][1]
    if language in {"es", "fr"}:
        return f"{ago} {days} {day}"
    return f"{days} {day} {ago}"


def battery(language: str) -> str:
    candidates = []
    for base in sorted(glob.glob("/sys/class/power_supply/*")):
        if (read_text(os.path.join(base, "type")) or "").lower() == "battery":
            candidates.append(base)
    if not candidates:
        return "—"
    base = candidates[0]
    capacity = read_text(os.path.join(base, "capacity")) or "—"
    raw_status = read_text(os.path.join(base, "status")) or "Unknown"
    statuses = TEXT[language][2]
    status = statuses.get(raw_status, statuses["Unknown"])
    temperature = None
    for name in ("temp", "temperature", "temp_now"):
        raw = read_text(os.path.join(base, name))
        if raw is None:
            continue
        try:
            value = float(raw)
        except ValueError:
            continue
        if abs(value) >= 1000:
            value /= 1000
        elif abs(value) >= 200:
            value /= 10
        temperature = f"{value:.1f}°C"
        break
    return f"{capacity}% • {status} • {temperature or '—'}"


def main() -> int:
    if len(sys.argv) != 3 or sys.argv[1] not in {"uptime", "installation-age", "battery"}:
        print("usage: senemos-fastfetch-value {uptime|installation-age|battery} LANGUAGE", file=sys.stderr)
        return 2
    language = sys.argv[2].lower()
    if language not in TEXT:
        language = "en"
    handlers = {"uptime": uptime, "installation-age": installation_age, "battery": battery}
    print(handlers[sys.argv[1]](language))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
