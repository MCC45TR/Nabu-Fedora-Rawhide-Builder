{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "modules": [
        {
            "type": "os",
            "key": "Sistem Operasi",
            "format": "{name} {version}"
        },
        {
            "type": "uptime",
            "key": "Waktu Aktif",
            "format": "{?days}{days} hari {?}{hours} jam {minutes} menit"
        },
        {
            "type": "command",
            "key": "Tanggal Instalasi",
            "text": "birth_install=$(stat -c %W / 2>/dev/null); if [ -z \"$birth_install\" ] || [ \"$birth_install\" -le 0 ]; then echo '—'; else date -d \"@$birth_install\" +%F; fi"
        },
        {
            "type": "kernel",
            "key": "Kernel"
        },
        {
            "type": "loadavg",
            "key": "Beban Rata-rata"
        },
        {
            "type": "wm",
            "key": "Manajer Jendela"
        },
        {
            "type": "DE",
            "key": "Lingkungan Desktop"
        },
        {
            "type": "shell",
            "key": "Shell"
        },
        {
            "type": "processes",
            "key": "Proses"
        },
        {
            "type": "terminal",
            "key": "Terminal",
            "format": "{pretty-name} {version} {#37}█{#97}█ {#36}█{#96}█ {#35}█{#95}█ {#34}█{#94}█ {#33}█{#93}█ {#32}█{#92}█ {#31}█{#91}█ {#30}█{#90}█"
        },
        {
            "type": "packages",
            "key": "Paket Terpasang"
        },
        {
            "type": "cpu",
            "key": "Prosesor",
            "temp": true,
            "format": "{name} {temperature}"
        },
        {
            "type": "gpu",
            "key": "Grafis {index}",
            "temp": true,
            "format": "{name} {temperature}"
        },
        {
            "type": "memory",
            "key": "Memori"
        },
        {
            "type": "disk",
            "key": "Penyimpanan {name}",
            "format": "{size-used} / {size-total} ({size-percentage})"
        },
        {
            "type": "localip",
            "key": "Alamat Jaringan",
            "showIpv6": true,
            "showPrefixLen": false
        }
    ]
}
