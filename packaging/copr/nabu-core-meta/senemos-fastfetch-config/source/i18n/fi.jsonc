{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "modules": [
        {
            "type": "os",
            "key": "Käyttöjärjestelmä",
            "format": "{name} {version}"
        },
        {
            "type": "uptime",
            "key": "Käynnissäoloaika",
            "format": "{?days}{days} pv {?}{hours} h {minutes} min"
        },
        {
            "type": "command",
            "key": "Asennuspäivä",
            "text": "birth_install=$(stat -c %W / 2>/dev/null); if [ -z \"$birth_install\" ] || [ \"$birth_install\" -le 0 ]; then echo '—'; else date -d \"@$birth_install\" +%F; fi"
        },
        {
            "type": "kernel",
            "key": "Ydin"
        },
        {
            "type": "loadavg",
            "key": "Keskimääräinen kuorma"
        },
        {
            "type": "wm",
            "key": "Ikkunanhallinta"
        },
        {
            "type": "DE",
            "key": "Työpöytäympäristö"
        },
        {
            "type": "shell",
            "key": "Komentotulkki"
        },
        {
            "type": "processes",
            "key": "Prosessit"
        },
        {
            "type": "terminal",
            "key": "Pääte",
            "format": "{pretty-name} {version} {#37}█{#97}█ {#36}█{#96}█ {#35}█{#95}█ {#34}█{#94}█ {#33}█{#93}█ {#32}█{#92}█ {#31}█{#91}█ {#30}█{#90}█"
        },
        {
            "type": "packages",
            "key": "Asennetut paketit"
        },
        {
            "type": "cpu",
            "key": "Suoritin",
            "temp": true,
            "format": "{name} {temperature}"
        },
        {
            "type": "gpu",
            "key": "Grafiikka {index}",
            "temp": true,
            "format": "{name} {temperature}"
        },
        {
            "type": "memory",
            "key": "Muisti"
        },
        {
            "type": "disk",
            "key": "Tallennustila {name}",
            "format": "{size-used} / {size-total} ({size-percentage})"
        },
        {
            "type": "localip",
            "key": "Verkko-osoite",
            "showIpv6": true,
            "showPrefixLen": false
        }
    ]
}
