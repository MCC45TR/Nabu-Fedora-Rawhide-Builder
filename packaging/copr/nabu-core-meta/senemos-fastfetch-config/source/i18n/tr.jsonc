{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "modules": [
        {
            "type": "os",
            "key": "İşletim Sistemi",
            "format": "{name} {version}"
        },
        {
            "type": "uptime",
            "key": "Çalışma Süresi",
            "format": "{?days}{days} gün {?}{hours} sa {minutes} dk"
        },
        {
            "type": "command",
            "key": "Kurulum Tarihi",
            "text": "birth_install=$(stat -c %W / 2>/dev/null); if [ -z \"$birth_install\" ] || [ \"$birth_install\" -le 0 ]; then echo '—'; else date -d \"@$birth_install\" +%F; fi"
        },
        {
            "type": "kernel",
            "key": "Çekirdek"
        },
        {
            "type": "loadavg",
            "key": "Ortalama Yük"
        },
        {
            "type": "wm",
            "key": "Pencere Yöneticisi"
        },
        {
            "type": "DE",
            "key": "Masaüstü Ortamı"
        },
        {
            "type": "shell",
            "key": "Kabuk"
        },
        {
            "type": "processes",
            "key": "Süreçler"
        },
        {
            "type": "terminal",
            "key": "Terminal",
            "format": "{pretty-name} {version} {#37}█{#97}█ {#36}█{#96}█ {#35}█{#95}█ {#34}█{#94}█ {#33}█{#93}█ {#32}█{#92}█ {#31}█{#91}█ {#30}█{#90}█"
        },
        {
            "type": "packages",
            "key": "Yüklü Paketler"
        },
        {
            "type": "cpu",
            "key": "İşlemci",
            "temp": true,
            "format": "{name} {temperature}"
        },
        {
            "type": "gpu",
            "key": "Grafik {index}",
            "temp": true,
            "format": "{name} {temperature}"
        },
        {
            "type": "memory",
            "key": "Bellek"
        },
        {
            "type": "disk",
            "key": "Depolama {name}",
            "format": "{size-used} / {size-total} ({size-percentage})"
        },
        {
            "type": "localip",
            "key": "Ağ Adresi",
            "showIpv6": true,
            "showPrefixLen": false
        }
    ]
}
