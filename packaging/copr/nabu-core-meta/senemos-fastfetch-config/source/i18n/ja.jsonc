{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "modules": [
        {
            "type": "os",
            "key": "オペレーティングシステム",
            "format": "{name} {version}"
        },
        {
            "type": "uptime",
            "key": "稼働時間",
            "format": "{?days}{days} 日 {?}{hours} 時間 {minutes} 分"
        },
        {
            "type": "command",
            "key": "インストール日",
            "text": "birth_install=$(stat -c %W / 2>/dev/null); if [ -z \"$birth_install\" ] || [ \"$birth_install\" -le 0 ]; then echo '—'; else date -d \"@$birth_install\" +%F; fi"
        },
        {
            "type": "kernel",
            "key": "カーネル"
        },
        {
            "type": "loadavg",
            "key": "平均負荷"
        },
        {
            "type": "wm",
            "key": "ウィンドウマネージャー"
        },
        {
            "type": "DE",
            "key": "デスクトップ環境"
        },
        {
            "type": "shell",
            "key": "シェル"
        },
        {
            "type": "processes",
            "key": "プロセス"
        },
        {
            "type": "terminal",
            "key": "端末",
            "format": "{pretty-name} {version} {#37}█{#97}█ {#36}█{#96}█ {#35}█{#95}█ {#34}█{#94}█ {#33}█{#93}█ {#32}█{#92}█ {#31}█{#91}█ {#30}█{#90}█"
        },
        {
            "type": "packages",
            "key": "インストール済みパッケージ"
        },
        {
            "type": "cpu",
            "key": "プロセッサー",
            "temp": true,
            "format": "{name} {temperature}"
        },
        {
            "type": "gpu",
            "key": "グラフィックス {index}",
            "temp": true,
            "format": "{name} {temperature}"
        },
        {
            "type": "memory",
            "key": "メモリ"
        },
        {
            "type": "disk",
            "key": "ストレージ {name}",
            "format": "{size-used} / {size-total} ({size-percentage})"
        },
        {
            "type": "localip",
            "key": "ネットワークアドレス",
            "showIpv6": true,
            "showPrefixLen": false
        }
    ]
}
