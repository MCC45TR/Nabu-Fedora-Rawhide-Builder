{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "modules": [
        {
            "type": "os",
            "key": "سیستم‌عامل",
            "format": "{name} {version}"
        },
        {
            "type": "uptime",
            "key": "زمان روشن بودن",
            "format": "{?days}{days} روز {?}{hours} ساعت {minutes} دقیقه"
        },
        {
            "type": "command",
            "key": "تاریخ نصب",
            "text": "birth_install=$(stat -c %W / 2>/dev/null); if [ -z \"$birth_install\" ] || [ \"$birth_install\" -le 0 ]; then echo '—'; else date -d \"@$birth_install\" +%F; fi"
        },
        {
            "type": "kernel",
            "key": "هسته"
        },
        {
            "type": "loadavg",
            "key": "میانگین بار"
        },
        {
            "type": "wm",
            "key": "مدیر پنجره"
        },
        {
            "type": "DE",
            "key": "محیط میزکار"
        },
        {
            "type": "shell",
            "key": "پوسته"
        },
        {
            "type": "processes",
            "key": "فرایندها"
        },
        {
            "type": "terminal",
            "key": "پایانه",
            "format": "{pretty-name} {version} {#37}█{#97}█ {#36}█{#96}█ {#35}█{#95}█ {#34}█{#94}█ {#33}█{#93}█ {#32}█{#92}█ {#31}█{#91}█ {#30}█{#90}█"
        },
        {
            "type": "packages",
            "key": "بسته‌های نصب‌شده"
        },
        {
            "type": "cpu",
            "key": "پردازنده",
            "temp": true,
            "format": "{name} {temperature}"
        },
        {
            "type": "gpu",
            "key": "گرافیک {index}",
            "temp": true,
            "format": "{name} {temperature}"
        },
        {
            "type": "memory",
            "key": "حافظه"
        },
        {
            "type": "disk",
            "key": "فضای ذخیره‌سازی {name}",
            "format": "{size-used} / {size-total} ({size-percentage})"
        },
        {
            "type": "localip",
            "key": "نشانی شبکه",
            "showIpv6": true,
            "showPrefixLen": false
        }
    ]
}
