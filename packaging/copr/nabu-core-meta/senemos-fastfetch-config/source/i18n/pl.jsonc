{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "modules": [
        {
            "type": "os",
            "key": "System operacyjny",
            "format": "{name} {version}"
        },
        {
            "type": "uptime",
            "key": "Czas działania",
            "format": "{?days}{days} d {?}{hours} godz. {minutes} min"
        },
        {
            "type": "command",
            "key": "Data instalacji",
            "text": "birth_install=$(stat -c %W / 2>/dev/null); if [ -z \"$birth_install\" ] || [ \"$birth_install\" -le 0 ]; then echo '—'; else date -d \"@$birth_install\" +%F; fi"
        },
        {
            "type": "kernel",
            "key": "Jądro"
        },
        {
            "type": "loadavg",
            "key": "Średnie obciążenie"
        },
        {
            "type": "wm",
            "key": "Menedżer okien"
        },
        {
            "type": "DE",
            "key": "Środowisko graficzne"
        },
        {
            "type": "shell",
            "key": "Powłoka"
        },
        {
            "type": "processes",
            "key": "Procesy"
        },
        {
            "type": "terminal",
            "key": "Terminal",
            "format": "{pretty-name} {version} {#37}█{#97}█ {#36}█{#96}█ {#35}█{#95}█ {#34}█{#94}█ {#33}█{#93}█ {#32}█{#92}█ {#31}█{#91}█ {#30}█{#90}█"
        },
        {
            "type": "packages",
            "key": "Zainstalowane pakiety"
        },
        {
            "type": "cpu",
            "key": "Procesor",
            "temp": true,
            "format": "{name} {temperature}"
        },
        {
            "type": "gpu",
            "key": "Grafika {index}",
            "temp": true,
            "format": "{name} {temperature}"
        },
        {
            "type": "memory",
            "key": "Pamięć"
        },
        {
            "type": "disk",
            "key": "Pamięć masowa {name}",
            "format": "{size-used} / {size-total} ({size-percentage})"
        },
        {
            "type": "localip",
            "key": "Adres sieciowy",
            "showIpv6": true,
            "showPrefixLen": false
        }
    ]
}
