{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "modules": [
        {
            "type": "os",
            "key": "ऑपरेटिंग सिस्टम",
            "format": "{name} {version}"
        },
        {
            "type": "uptime",
            "key": "चालू रहने का समय",
            "format": "{?days}{days} दिन {?}{hours} घंटे {minutes} मिनट"
        },
        {
            "type": "command",
            "key": "स्थापना तिथि",
            "text": "birth_install=$(stat -c %W / 2>/dev/null); if [ -z \"$birth_install\" ] || [ \"$birth_install\" -le 0 ]; then echo '—'; else date -d \"@$birth_install\" +%F; fi"
        },
        {
            "type": "kernel",
            "key": "कर्नेल"
        },
        {
            "type": "loadavg",
            "key": "औसत लोड"
        },
        {
            "type": "wm",
            "key": "विंडो प्रबंधक"
        },
        {
            "type": "DE",
            "key": "डेस्कटॉप वातावरण"
        },
        {
            "type": "shell",
            "key": "शेल"
        },
        {
            "type": "processes",
            "key": "प्रक्रियाएँ"
        },
        {
            "type": "terminal",
            "key": "टर्मिनल",
            "format": "{pretty-name} {version} {#37}█{#97}█ {#36}█{#96}█ {#35}█{#95}█ {#34}█{#94}█ {#33}█{#93}█ {#32}█{#92}█ {#31}█{#91}█ {#30}█{#90}█"
        },
        {
            "type": "packages",
            "key": "स्थापित पैकेज"
        },
        {
            "type": "cpu",
            "key": "प्रोसेसर",
            "temp": true,
            "format": "{name} {temperature}"
        },
        {
            "type": "gpu",
            "key": "ग्राफ़िक्स {index}",
            "temp": true,
            "format": "{name} {temperature}"
        },
        {
            "type": "memory",
            "key": "मेमोरी"
        },
        {
            "type": "disk",
            "key": "स्टोरेज {name}",
            "format": "{size-used} / {size-total} ({size-percentage})"
        },
        {
            "type": "localip",
            "key": "नेटवर्क पता",
            "showIpv6": true,
            "showPrefixLen": false
        }
    ]
}
