{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "modules": [
        {
            "type": "os",
            "key": "آپریٹنگ سسٹم",
            "format": "{name} {version}"
        },
        {
            "type": "uptime",
            "key": "چلنے کا دورانیہ",
            "format": "{?days}{days} دن {?}{hours} گھنٹے {minutes} منٹ"
        },
        {
            "type": "command",
            "key": "تنصیب کی تاریخ",
            "text": "birth_install=$(stat -c %W / 2>/dev/null); if [ -z \"$birth_install\" ] || [ \"$birth_install\" -le 0 ]; then echo '—'; else date -d \"@$birth_install\" +%F; fi"
        },
        {
            "type": "kernel",
            "key": "کرنل"
        },
        {
            "type": "loadavg",
            "key": "اوسط لوڈ"
        },
        {
            "type": "wm",
            "key": "ونڈو مینیجر"
        },
        {
            "type": "DE",
            "key": "ڈیسک ٹاپ ماحول"
        },
        {
            "type": "shell",
            "key": "شیل"
        },
        {
            "type": "processes",
            "key": "عملیات"
        },
        {
            "type": "terminal",
            "key": "ٹرمینل",
            "format": "{pretty-name} {version} {#37}█{#97}█ {#36}█{#96}█ {#35}█{#95}█ {#34}█{#94}█ {#33}█{#93}█ {#32}█{#92}█ {#31}█{#91}█ {#30}█{#90}█"
        },
        {
            "type": "packages",
            "key": "نصب شدہ پیکیجز"
        },
        {
            "type": "cpu",
            "key": "پروسیسر",
            "temp": true,
            "format": "{name} {temperature}"
        },
        {
            "type": "gpu",
            "key": "گرافکس {index}",
            "temp": true,
            "format": "{name} {temperature}"
        },
        {
            "type": "memory",
            "key": "میموری"
        },
        {
            "type": "disk",
            "key": "ذخیرہ {name}",
            "format": "{size-used} / {size-total} ({size-percentage})"
        },
        {
            "type": "localip",
            "key": "نیٹ ورک پتہ",
            "showIpv6": true,
            "showPrefixLen": false
        }
    ]
}
