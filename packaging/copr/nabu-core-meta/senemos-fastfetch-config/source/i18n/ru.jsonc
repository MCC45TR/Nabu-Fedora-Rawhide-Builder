{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "modules": [
        {
            "type": "os",
            "key": "Операционная система",
            "format": "{name} {version}"
        },
        {
            "type": "uptime",
            "key": "Время работы",
            "format": "{?days}{days} д {?}{hours} ч {minutes} мин"
        },
        {
            "type": "command",
            "key": "Дата установки",
            "text": "birth_install=$(stat -c %W / 2>/dev/null); if [ -z \"$birth_install\" ] || [ \"$birth_install\" -le 0 ]; then echo '—'; else date -d \"@$birth_install\" +%F; fi"
        },
        {
            "type": "kernel",
            "key": "Ядро"
        },
        {
            "type": "loadavg",
            "key": "Средняя нагрузка"
        },
        {
            "type": "wm",
            "key": "Оконный менеджер"
        },
        {
            "type": "DE",
            "key": "Окружение рабочего стола"
        },
        {
            "type": "shell",
            "key": "Оболочка"
        },
        {
            "type": "processes",
            "key": "Процессы"
        },
        {
            "type": "terminal",
            "key": "Терминал",
            "format": "{pretty-name} {version} {#37}█{#97}█ {#36}█{#96}█ {#35}█{#95}█ {#34}█{#94}█ {#33}█{#93}█ {#32}█{#92}█ {#31}█{#91}█ {#30}█{#90}█"
        },
        {
            "type": "packages",
            "key": "Установленные пакеты"
        },
        {
            "type": "cpu",
            "key": "Процессор",
            "temp": true,
            "format": "{name} {temperature}"
        },
        {
            "type": "gpu",
            "key": "Графика {index}",
            "temp": true,
            "format": "{name} {temperature}"
        },
        {
            "type": "memory",
            "key": "Память"
        },
        {
            "type": "disk",
            "key": "Хранилище {name}",
            "format": "{size-used} / {size-total} ({size-percentage})"
        },
        {
            "type": "localip",
            "key": "Сетевой адрес",
            "showIpv6": true,
            "showPrefixLen": false
        }
    ]
}
