{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "modules": [
        {
            "type": "os",
            "key": "Operační systém",
            "format": "{name} {version}"
        },
        {
            "type": "uptime",
            "key": "Doba běhu",
            "format": "{?days}{days} d {?}{hours} h {minutes} min"
        },
        {
            "type": "command",
            "key": "Datum instalace",
            "text": "birth_install=$(stat -c %W / 2>/dev/null); if [ -z \"$birth_install\" ] || [ \"$birth_install\" -le 0 ]; then echo '—'; else date -d \"@$birth_install\" +%F; fi"
        },
        {
            "type": "kernel",
            "key": "Jádro"
        },
        {
            "type": "loadavg",
            "key": "Průměrná zátěž"
        },
        {
            "type": "wm",
            "key": "Správce oken"
        },
        {
            "type": "DE",
            "key": "Pracovní prostředí"
        },
        {
            "type": "shell",
            "key": "Shell"
        },
        {
            "type": "processes",
            "key": "Procesy"
        },
        {
            "type": "terminal",
            "key": "Terminál",
            "format": "{pretty-name} {version} {#37}█{#97}█ {#36}█{#96}█ {#35}█{#95}█ {#34}█{#94}█ {#33}█{#93}█ {#32}█{#92}█ {#31}█{#91}█ {#30}█{#90}█"
        },
        {
            "type": "packages",
            "key": "Nainstalované balíčky"
        },
        {
            "type": "cpu",
            "key": "Procesor",
            "temp": true,
            "format": "{name} {temperature}"
        },
        {
            "type": "gpu",
            "key": "Grafika {index}",
            "temp": true,
            "format": "{name} {temperature}"
        },
        {
            "type": "memory",
            "key": "Paměť"
        },
        {
            "type": "disk",
            "key": "Úložiště {name}",
            "format": "{size-used} / {size-total} ({size-percentage})"
        },
        {
            "type": "localip",
            "key": "Síťová adresa",
            "showIpv6": true,
            "showPrefixLen": false
        }
    ]
}
