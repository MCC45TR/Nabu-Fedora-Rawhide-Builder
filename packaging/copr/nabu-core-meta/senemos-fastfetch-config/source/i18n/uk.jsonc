{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "modules": [
        {
            "type": "os",
            "key": "Операційна система",
            "format": "{name} {version}"
        },
        {
            "type": "uptime",
            "key": "Час роботи",
            "format": "{?days}{days} д {?}{hours} год {minutes} хв"
        },
        {
            "type": "command",
            "key": "Дата встановлення",
            "text": "birth_install=$(stat -c %W / 2>/dev/null); if [ -z \"$birth_install\" ] || [ \"$birth_install\" -le 0 ]; then echo '—'; else date -d \"@$birth_install\" +%F; fi"
        },
        {
            "type": "kernel",
            "key": "Ядро"
        },
        {
            "type": "loadavg",
            "key": "Середнє навантаження"
        },
        {
            "type": "wm",
            "key": "Менеджер вікон"
        },
        {
            "type": "DE",
            "key": "Стільничне середовище"
        },
        {
            "type": "shell",
            "key": "Оболонка"
        },
        {
            "type": "processes",
            "key": "Процеси"
        },
        {
            "type": "terminal",
            "key": "Термінал",
            "format": "{pretty-name} {version} {#37}█{#97}█ {#36}█{#96}█ {#35}█{#95}█ {#34}█{#94}█ {#33}█{#93}█ {#32}█{#92}█ {#31}█{#91}█ {#30}█{#90}█"
        },
        {
            "type": "packages",
            "key": "Встановлені пакунки"
        },
        {
            "type": "cpu",
            "key": "Процесор",
            "temp": true,
            "format": "{name} {temperature}"
        },
        {
            "type": "gpu",
            "key": "Графіка {index}",
            "temp": true,
            "format": "{name} {temperature}"
        },
        {
            "type": "memory",
            "key": "Пам’ять"
        },
        {
            "type": "disk",
            "key": "Сховище {name}",
            "format": "{size-used} / {size-total} ({size-percentage})"
        },
        {
            "type": "localip",
            "key": "Мережева адреса",
            "showIpv6": true,
            "showPrefixLen": false
        }
    ]
}
