{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "modules": [
        {
            "type": "os",
            "key": "Besturingssysteem",
            "format": "{name} {version}"
        },
        {
            "type": "uptime",
            "key": "Bedrijfstijd",
            "format": "{?days}{days} d {?}{hours} u {minutes} min"
        },
        {
            "type": "command",
            "key": "Installatiedatum",
            "text": "birth_install=$(stat -c %W / 2>/dev/null); if [ -z \"$birth_install\" ] || [ \"$birth_install\" -le 0 ]; then echo '—'; else date -d \"@$birth_install\" +%F; fi"
        },
        {
            "type": "kernel",
            "key": "Kernel"
        },
        {
            "type": "loadavg",
            "key": "Gemiddelde belasting"
        },
        {
            "type": "wm",
            "key": "Vensterbeheerder"
        },
        {
            "type": "DE",
            "key": "Bureaubladomgeving"
        },
        {
            "type": "shell",
            "key": "Shell"
        },
        {
            "type": "processes",
            "key": "Processen"
        },
        {
            "type": "terminal",
            "key": "Terminal",
            "format": "{pretty-name} {version} {#37}█{#97}█ {#36}█{#96}█ {#35}█{#95}█ {#34}█{#94}█ {#33}█{#93}█ {#32}█{#92}█ {#31}█{#91}█ {#30}█{#90}█"
        },
        {
            "type": "packages",
            "key": "Geïnstalleerde pakketten"
        },
        {
            "type": "cpu",
            "key": "Processor",
            "temp": true,
            "format": "{name} {temperature}"
        },
        {
            "type": "gpu",
            "key": "Grafisch {index}",
            "temp": true,
            "format": "{name} {temperature}"
        },
        {
            "type": "memory",
            "key": "Geheugen"
        },
        {
            "type": "disk",
            "key": "Opslag {name}",
            "format": "{size-used} / {size-total} ({size-percentage})"
        },
        {
            "type": "localip",
            "key": "Netwerkadres",
            "showIpv6": true,
            "showPrefixLen": false
        }
    ]
}
