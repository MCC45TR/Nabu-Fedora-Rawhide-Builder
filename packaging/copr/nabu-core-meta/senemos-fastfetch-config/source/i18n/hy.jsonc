{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "modules": [
        {
            "type": "os",
            "key": "Օպերացիոն համակարգ",
            "format": "{name} {version}"
        },
        {
            "type": "uptime",
            "key": "Աշխատաժամանակ",
            "format": "{?days}{days} օր {?}{hours} ժամ {minutes} րոպե"
        },
        {
            "type": "command",
            "key": "Տեղադրման ամսաթիվ",
            "text": "birth_install=$(stat -c %W / 2>/dev/null); if [ -z \"$birth_install\" ] || [ \"$birth_install\" -le 0 ]; then echo '—'; else date -d \"@$birth_install\" +%F; fi"
        },
        {
            "type": "kernel",
            "key": "Միջուկ"
        },
        {
            "type": "loadavg",
            "key": "Միջին բեռնվածություն"
        },
        {
            "type": "wm",
            "key": "Պատուհանների կառավարիչ"
        },
        {
            "type": "DE",
            "key": "Աշխատասեղանի միջավայր"
        },
        {
            "type": "shell",
            "key": "Թաղանթ"
        },
        {
            "type": "processes",
            "key": "Գործընթացներ"
        },
        {
            "type": "terminal",
            "key": "Տերմինալ",
            "format": "{pretty-name} {version} {#37}█{#97}█ {#36}█{#96}█ {#35}█{#95}█ {#34}█{#94}█ {#33}█{#93}█ {#32}█{#92}█ {#31}█{#91}█ {#30}█{#90}█"
        },
        {
            "type": "packages",
            "key": "Տեղադրված փաթեթներ"
        },
        {
            "type": "cpu",
            "key": "Պրոցեսոր",
            "temp": true,
            "format": "{name} {temperature}"
        },
        {
            "type": "gpu",
            "key": "Գրաֆիկա {index}",
            "temp": true,
            "format": "{name} {temperature}"
        },
        {
            "type": "memory",
            "key": "Հիշողություն"
        },
        {
            "type": "disk",
            "key": "Պահոց {name}",
            "format": "{size-used} / {size-total} ({size-percentage})"
        },
        {
            "type": "localip",
            "key": "Ցանցային հասցե",
            "showIpv6": true,
            "showPrefixLen": false
        }
    ]
}
