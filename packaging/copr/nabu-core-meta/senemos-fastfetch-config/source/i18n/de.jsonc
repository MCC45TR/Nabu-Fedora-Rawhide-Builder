{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "modules": [
        {
            "type": "os",
            "key": "Betriebssystem",
            "format": "{name} {version}"
        },
        {
            "type": "uptime",
            "key": "Laufzeit",
            "format": "{?days}{days} T {?}{hours} Std. {minutes} Min."
        },
        {
            "type": "command",
            "key": "Installationsdatum",
            "text": "birth_install=$(stat -c %W / 2>/dev/null); if [ -z \"$birth_install\" ] || [ \"$birth_install\" -le 0 ]; then echo '—'; else date -d \"@$birth_install\" +%F; fi"
        },
        {
            "type": "kernel",
            "key": "Kernel"
        },
        {
            "type": "loadavg",
            "key": "Durchschnittliche Last"
        },
        {
            "type": "wm",
            "key": "Fensterverwaltung"
        },
        {
            "type": "DE",
            "key": "Arbeitsumgebung"
        },
        {
            "type": "shell",
            "key": "Shell"
        },
        {
            "type": "processes",
            "key": "Prozesse"
        },
        {
            "type": "terminal",
            "key": "Terminal",
            "format": "{pretty-name} {version} {#37}█{#97}█ {#36}█{#96}█ {#35}█{#95}█ {#34}█{#94}█ {#33}█{#93}█ {#32}█{#92}█ {#31}█{#91}█ {#30}█{#90}█"
        },
        {
            "type": "packages",
            "key": "Installierte Pakete"
        },
        {
            "type": "cpu",
            "key": "Prozessor",
            "temp": true,
            "format": "{name} {temperature}"
        },
        {
            "type": "gpu",
            "key": "Grafik {index}",
            "temp": true,
            "format": "{name} {temperature}"
        },
        {
            "type": "memory",
            "key": "Arbeitsspeicher"
        },
        {
            "type": "disk",
            "key": "Speicher {name}",
            "format": "{size-used} / {size-total} ({size-percentage})"
        },
        {
            "type": "localip",
            "key": "Netzwerkadresse",
            "showIpv6": true,
            "showPrefixLen": false
        }
    ]
}
