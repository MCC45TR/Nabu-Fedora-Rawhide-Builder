{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "modules": [
        {
            "type": "os",
            "key": "Əməliyyat sistemi",
            "format": "{name} {version}"
        },
        {
            "type": "uptime",
            "key": "İşləmə müddəti",
            "format": "{?days}{days} gün {?}{hours} saat {minutes} dəqiqə"
        },
        {
            "type": "command",
            "key": "Quraşdırma tarixi",
            "text": "birth_install=$(stat -c %W / 2>/dev/null); if [ -z \"$birth_install\" ] || [ \"$birth_install\" -le 0 ]; then echo '—'; else date -d \"@$birth_install\" +%F; fi"
        },
        {
            "type": "kernel",
            "key": "Nüvə"
        },
        {
            "type": "loadavg",
            "key": "Orta yük"
        },
        {
            "type": "wm",
            "key": "Pəncərə meneceri"
        },
        {
            "type": "DE",
            "key": "İş masası mühiti"
        },
        {
            "type": "shell",
            "key": "Qabıq"
        },
        {
            "type": "processes",
            "key": "Proseslər"
        },
        {
            "type": "terminal",
            "key": "Terminal",
            "format": "{pretty-name} {version} {#37}█{#97}█ {#36}█{#96}█ {#35}█{#95}█ {#34}█{#94}█ {#33}█{#93}█ {#32}█{#92}█ {#31}█{#91}█ {#30}█{#90}█"
        },
        {
            "type": "packages",
            "key": "Quraşdırılmış paketlər"
        },
        {
            "type": "cpu",
            "key": "Prosessor",
            "temp": true,
            "format": "{name} {temperature}"
        },
        {
            "type": "gpu",
            "key": "Qrafika {index}",
            "temp": true,
            "format": "{name} {temperature}"
        },
        {
            "type": "memory",
            "key": "Yaddaş"
        },
        {
            "type": "disk",
            "key": "Saxlama {name}",
            "format": "{size-used} / {size-total} ({size-percentage})"
        },
        {
            "type": "localip",
            "key": "Şəbəkə ünvanı",
            "showIpv6": true,
            "showPrefixLen": false
        }
    ]
}
