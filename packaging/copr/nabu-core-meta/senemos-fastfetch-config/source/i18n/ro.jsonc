{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "modules": [
        {
            "type": "os",
            "key": "Sistem de operare",
            "format": "{name} {version}"
        },
        {
            "type": "uptime",
            "key": "Timp de funcționare",
            "format": "{?days}{days} z {?}{hours} h {minutes} min"
        },
        {
            "type": "command",
            "key": "Data instalării",
            "text": "birth_install=$(stat -c %W / 2>/dev/null); if [ -z \"$birth_install\" ] || [ \"$birth_install\" -le 0 ]; then echo '—'; else date -d \"@$birth_install\" +%F; fi"
        },
        {
            "type": "kernel",
            "key": "Nucleu"
        },
        {
            "type": "loadavg",
            "key": "Încărcare medie"
        },
        {
            "type": "wm",
            "key": "Gestionar de ferestre"
        },
        {
            "type": "DE",
            "key": "Mediu desktop"
        },
        {
            "type": "shell",
            "key": "Shell"
        },
        {
            "type": "processes",
            "key": "Procese"
        },
        {
            "type": "terminal",
            "key": "Terminal",
            "format": "{pretty-name} {version} {#37}█{#97}█ {#36}█{#96}█ {#35}█{#95}█ {#34}█{#94}█ {#33}█{#93}█ {#32}█{#92}█ {#31}█{#91}█ {#30}█{#90}█"
        },
        {
            "type": "packages",
            "key": "Pachete instalate"
        },
        {
            "type": "cpu",
            "key": "Procesor",
            "temp": true,
            "format": "{name} {temperature}"
        },
        {
            "type": "gpu",
            "key": "Grafică {index}",
            "temp": true,
            "format": "{name} {temperature}"
        },
        {
            "type": "memory",
            "key": "Memorie"
        },
        {
            "type": "disk",
            "key": "Stocare {name}",
            "format": "{size-used} / {size-total} ({size-percentage})"
        },
        {
            "type": "localip",
            "key": "Adresă de rețea",
            "showIpv6": true,
            "showPrefixLen": false
        }
    ]
}
