{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "modules": [
        {
            "type": "os",
            "key": "操作系统",
            "format": "{name} {version}"
        },
        {
            "type": "uptime",
            "key": "运行时间",
            "format": "{?days}{days} 天 {?}{hours} 小时 {minutes} 分钟"
        },
        {
            "type": "command",
            "key": "安装日期",
            "text": "birth_install=$(stat -c %W / 2>/dev/null); if [ -z \"$birth_install\" ] || [ \"$birth_install\" -le 0 ]; then echo '—'; else date -d \"@$birth_install\" +%F; fi"
        },
        {
            "type": "kernel",
            "key": "内核"
        },
        {
            "type": "loadavg",
            "key": "平均负载"
        },
        {
            "type": "wm",
            "key": "窗口管理器"
        },
        {
            "type": "DE",
            "key": "桌面环境"
        },
        {
            "type": "shell",
            "key": "Shell"
        },
        {
            "type": "processes",
            "key": "进程"
        },
        {
            "type": "terminal",
            "key": "终端",
            "format": "{pretty-name} {version} {#37}█{#97}█ {#36}█{#96}█ {#35}█{#95}█ {#34}█{#94}█ {#33}█{#93}█ {#32}█{#92}█ {#31}█{#91}█ {#30}█{#90}█"
        },
        {
            "type": "packages",
            "key": "已安装的软件包"
        },
        {
            "type": "cpu",
            "key": "处理器",
            "temp": true,
            "format": "{name} {temperature}"
        },
        {
            "type": "gpu",
            "key": "图形 {index}",
            "temp": true,
            "format": "{name} {temperature}"
        },
        {
            "type": "memory",
            "key": "内存"
        },
        {
            "type": "disk",
            "key": "存储 {name}",
            "format": "{size-used} / {size-total} ({size-percentage})"
        },
        {
            "type": "localip",
            "key": "网络地址",
            "showIpv6": true,
            "showPrefixLen": false
        }
    ]
}
