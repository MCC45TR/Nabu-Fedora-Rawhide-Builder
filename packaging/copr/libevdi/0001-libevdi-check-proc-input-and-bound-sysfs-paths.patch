-	fscanf(pf, "%6s", name); // Xorg process had name (Xorg)
+	if (name == NULL)
+		return NULL;
+	if (fscanf(pf, "%ld %6s", &pid, name) != 2) {
+		free(name);
+		return NULL;
+	}
 
 	return name;
