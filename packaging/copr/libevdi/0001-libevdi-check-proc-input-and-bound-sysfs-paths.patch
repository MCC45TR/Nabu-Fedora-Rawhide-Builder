diff --git a/library/evdi_procfs.c b/library/evdi_procfs.c
index 15bf6cd..bc2746f 100644
--- a/library/evdi_procfs.c
+++ b/library/evdi_procfs.c
@@ -24,7 +24,11 @@ static FILE *open_process_folder(const char *pid)
 	FILE *pf;
 	char command[command_length];
 
-	snprintf(command, command_length, "/proc/%s/stat", pid);
+	/* Linux PID directories fit in 20 digits; reject truncated/non-PID paths. */
+	size_t length = strnlen(pid, 21);
+	if (length == 0 || length > 20 || strspn(pid, "0123456789") != length)
+		return NULL;
+	snprintf(command, command_length, "/proc/%.*s/stat", 20, pid);
 	pf = fopen(command, "r");
 
 	return pf;
