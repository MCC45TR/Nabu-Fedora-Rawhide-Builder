[Unit]
Description=Install Fedora language support selected in initial setup
After=network-online.target plasma-setup.service
Wants=network-online.target
ConditionPathExists=/etc/plasma-setup-done

[Service]
Type=oneshot
ExecStart=/usr/libexec/senemos-nabu/nabu-locale-packages
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=15min
