#!/usr/bin/bash
set -Eeuo pipefail

root=${NABU_SELINUX_ROOT:-/}
contexts="$root/etc/selinux/targeted/contexts/files/file_contexts"
stamp="$root/var/lib/senemos-nabu/selinux-label-ready"
marker="$root/.autorelabel"

if [[ $root != /* || ! -d $root ]]; then
    printf 'Invalid SELinux preparation root: %s\n' "$root" >&2
    exit 2
fi

if [[ ! -s $contexts ]]; then
    printf 'SELinux file-context policy is unavailable: %s\n' "$contexts" >&2
    exit 1
fi

if [[ $root == / && -r /sys/firmware/devicetree/base/compatible ]] &&
   ! grep -aq 'xiaomi,nabu' /sys/firmware/devicetree/base/compatible; then
    printf 'SELinux label preparation skipped: this is not Xiaomi Nabu.\n'
    exit 0
fi

selinux_kernel=0
for config in "$root"/boot/config-*nabu*; do
    [[ -r $config ]] || continue
    if grep -Fxq 'CONFIG_SECURITY_SELINUX=y' "$config"; then
        selinux_kernel=1
        break
    fi
done
if (( ! selinux_kernel )); then
    printf 'SELinux label preparation skipped: no SELinux-capable Nabu kernel is installed.\n'
    exit 0
fi

policy_digest=$(sha256sum "$contexts" | awk '{print $1}')
if [[ ! -e $marker && -r $stamp ]] &&
   grep -Fxq "policy=$policy_digest" "$stamp"; then
    printf 'SELinux labels already match the installed policy.\n'
    exit 0
fi

setfiles_bin=$(command -v setfiles || :)
[[ -x $setfiles_bin ]] || {
    printf 'setfiles is required to prepare the Nabu root filesystem.\n' >&2
    exit 1
}

setfiles_args=(-F)
verify_args=(-n -v)
if [[ $root != / ]]; then
    setfiles_args+=(-r "$root")
    verify_args+=(-r "$root")
fi
for excluded in dev proc sys run tmp boot/efi mnt/vendor/persist var/lib/nabu-boot-backup; do
    excluded_path="$root/${excluded}"
    [[ -e $excluded_path ]] || continue
    setfiles_args+=(-e "$excluded_path")
    verify_args+=(-e "$excluded_path")
done

printf 'Preparing SELinux labels for the Nabu root filesystem.\n'
"$setfiles_bin" "${setfiles_args[@]}" "$contexts" "$root"

verify_log=$(mktemp /var/tmp/nabu-selinux-verify.XXXXXXXX)
cleanup() {
    rm -f -- "$verify_log"
}
trap cleanup EXIT
if ! "$setfiles_bin" "${verify_args[@]}" "$contexts" "$root" >"$verify_log" 2>&1; then
    cat "$verify_log" >&2
    printf 'SELinux label verification failed.\n' >&2
    exit 1
fi
if [[ -s $verify_log ]]; then
    sed -n '1,80p' "$verify_log" >&2
    printf 'SELinux label verification still reports pending changes.\n' >&2
    exit 1
fi

install -d -m0755 "${stamp%/*}"
printf 'policy=%s\nprepared_at=%s\n' \
    "$policy_digest" \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$stamp"
chmod 0644 "$stamp"
rm -f -- "$marker"
printf 'SELinux labels are ready for an enforcing Nabu kernel.\n'
