#!/usr/bin/python3
"""Create KWin-compatible ICC profiles from an authorized Nabu QDCM XML.

The Qualcomm XML is never installed or copied.  Only the two static Android
HAL SDR modes are converted; dynamic, video, native and HDR modes need color
operations that cannot be represented faithfully by this converter.
"""

import argparse
import ctypes
import ctypes.util
import glob
import hashlib
import json
import math
import os
from pathlib import Path
import re
import struct
import subprocess
import sys
import tempfile
import time
import xml.etree.ElementTree as ET


SUPPORTED_MODES = {
    "srgb": ("hal_srgb", "srgb", "Android HAL sRGB"),
    "display-p3": ("hal_dci_p3", "display-p3", "Android HAL Display P3"),
}
PANEL_RE = re.compile(r"xiaomi_(36_02_0b|42_02_0a)_video_mode_dual_dsi_cphy_panel")
ICC_ROOT = Path(".local/share/icc/senemos/nabu")
SYSTEM_ICC_ROOT = Path("/usr/share/color/icc/senemos/nabu")
PACKAGED_PROFILE_RE = re.compile(
    r"xiaomi-nabu-(36-02-0b|42-02-0a)-(srgb|display-p3)\.icc"
)
PANEL_REVISIONS = {"36-02-0b", "42-02-0a"}
PANEL_REVISION_GLOB = "/sys/bus/mipi-dsi/devices/*/panel_revision"
PANEL_EFIVAR_GLOB = "/sys/firmware/efi/efivars/DisplayPanelConfiguration-*"
PANEL_EFIVAR_RE = re.compile(rb"(?:36_02_0b|42_02_0a)")

# Linear RGB (D65) to XYZ matrices, and Bradford-adapted D50 to D65.
RGB_TO_XYZ = {
    "srgb": (
        (0.4124564, 0.3575761, 0.1804375),
        (0.2126729, 0.7151522, 0.0721750),
        (0.0193339, 0.1191920, 0.9503041),
    ),
    "display-p3": (
        (0.48657095, 0.26566769, 0.19821729),
        (0.22897456, 0.69173852, 0.07928691),
        (0.00000000, 0.04511338, 1.04394437),
    ),
}
D50_TO_D65 = (
    (0.9555766, -0.0230393, 0.0631636),
    (-0.0282895, 1.0099416, 0.0210077),
    (0.0122982, -0.0204830, 1.3299098),
)


def fail(message):
    print(f"senemos-nabu-color-profile: {message}", file=sys.stderr)
    raise SystemExit(1)


def mat_vec(matrix, vector):
    return tuple(sum(row[i] * vector[i] for i in range(3)) for row in matrix)


def inverse3(matrix):
    a, b, c = matrix
    determinant = (
        a[0] * (b[1] * c[2] - b[2] * c[1])
        - a[1] * (b[0] * c[2] - b[2] * c[0])
        + a[2] * (b[0] * c[1] - b[1] * c[0])
    )
    return (
        ((b[1] * c[2] - b[2] * c[1]) / determinant,
         (a[2] * c[1] - a[1] * c[2]) / determinant,
         (a[1] * b[2] - a[2] * b[1]) / determinant),
        ((b[2] * c[0] - b[0] * c[2]) / determinant,
         (a[0] * c[2] - a[2] * c[0]) / determinant,
         (a[2] * b[0] - a[0] * b[2]) / determinant),
        ((b[0] * c[1] - b[1] * c[0]) / determinant,
         (a[1] * c[0] - a[0] * c[1]) / determinant,
         (a[0] * b[1] - a[1] * b[0]) / determinant),
    )


def clamp(value):
    return max(0.0, min(1.0, value))


def srgb_encode(value):
    value = clamp(value)
    if value <= 0.0031308:
        return 12.92 * value
    return 1.055 * value ** (1.0 / 2.4) - 0.055


def interpolate_curve(curve, value):
    position = clamp(value) * (len(curve) - 1)
    low = int(math.floor(position))
    high = min(low + 1, len(curve) - 1)
    fraction = position - low
    return curve[low] * (1.0 - fraction) + curve[high] * fraction


def interpolate_clut(table, value):
    coordinates = [clamp(component) * 16.0 for component in value]
    low = [int(math.floor(component)) for component in coordinates]
    high = [min(component + 1, 16) for component in low]
    fraction = [coordinates[i] - low[i] for i in range(3)]
    result = [0.0, 0.0, 0.0]
    for rb in (0, 1):
        r = high[0] if rb else low[0]
        rw = fraction[0] if rb else 1.0 - fraction[0]
        for gb in (0, 1):
            g = high[1] if gb else low[1]
            gw = fraction[1] if gb else 1.0 - fraction[1]
            for bb in (0, 1):
                b = high[2] if bb else low[2]
                bw = fraction[2] if bb else 1.0 - fraction[2]
                sample = table[b][g][r]
                weight = rw * gw * bw
                for channel in range(3):
                    result[channel] += sample[channel] * weight
    return tuple(result)


def feature_bytes(mode, feature_type):
    feature = next(
        (item for item in mode.findall("Feature")
         if item.get("FeatureType") == feature_type),
        None,
    )
    if feature is None or feature.get("Disable") != "false":
        fail(f"mode {mode.get('Name')} has no enabled feature {feature_type}")
    data = bytes.fromhex((feature.text or "").strip())
    if len(data) != int(feature.get("DataSize", "-1")):
        fail(f"feature {feature_type} size does not match its DataSize")
    return data


def decode_curve(data, points, maximum, expected_header):
    words = struct.unpack(f"<{len(data) // 4}I", data)
    if len(words) != 3075 or words[0] != expected_header or words[1] != points or words[2] != 6:
        fail(f"unexpected QDCM curve layout ({len(words)} words, {words[1]} points)")
    curves = []
    for channel in range(3):
        offset = 3 + channel * 1024
        curve = tuple(value / maximum for value in words[offset:offset + points])
        if any(curve[index] > curve[index + 1] for index in range(points - 1)):
            fail("QDCM curve is not monotonic")
        curves.append(curve)
    return tuple(curves)


def decode_clut(data):
    words = struct.unpack(f"<{len(data) // 4}I", data)
    if len(words) != 29482 or words[3] != 4913:
        fail("unexpected QDCM 17x17x17 LUT layout")
    table = [[[None for _ in range(17)] for _ in range(17)] for _ in range(17)]
    offset = 4
    for b in range(17):
        for g in range(17):
            for r in range(17):
                input_rgb = words[offset:offset + 3]
                expected = (r * 256, g * 256, b * 256)
                if tuple(input_rgb) != expected:
                    fail("QDCM 3D LUT input lattice is not the expected regular grid")
                output = words[offset + 3:offset + 6]
                table[b][g][r] = tuple(clamp(value / 4096.0) for value in output)
                offset += 6
    return table


class QdcmPipeline:
    def __init__(self, mode, gamut):
        self.gamut = gamut
        self.inverse_rgb_matrix = inverse3(RGB_TO_XYZ[gamut])
        self.input_curves = decode_curve(feature_bytes(mode, "7"), 256, 4095.0, 262144)
        self.clut = decode_clut(feature_bytes(mode, "3"))
        self.output_curves = decode_curve(feature_bytes(mode, "8"), 1024, 1023.0, 0)

    def evaluate_icc_xyz(self, encoded_xyz):
        # ICC XYZ LUT input uses 0..1 to encode a PCS XYZ range of 0..2.
        xyz_d50 = tuple(component * 2.0 for component in encoded_xyz)
        xyz_d65 = mat_vec(D50_TO_D65, xyz_d50)
        linear_rgb = mat_vec(self.inverse_rgb_matrix, xyz_d65)
        encoded_rgb = tuple(srgb_encode(component) for component in linear_rgb)
        degamma = tuple(
            interpolate_curve(self.input_curves[channel], encoded_rgb[channel])
            for channel in range(3)
        )
        corrected = interpolate_clut(self.clut, degamma)
        return tuple(
            interpolate_curve(self.output_curves[channel], corrected[channel])
            for channel in range(3)
        )


class CmsCIExyY(ctypes.Structure):
    _fields_ = [("x", ctypes.c_double), ("y", ctypes.c_double), ("Y", ctypes.c_double)]


class CmsCIExyYTriple(ctypes.Structure):
    _fields_ = [("Red", CmsCIExyY), ("Green", CmsCIExyY), ("Blue", CmsCIExyY)]


def signature(text):
    return int.from_bytes(text.encode("ascii"), "big")


class LittleCms:
    def __init__(self):
        library = ctypes.util.find_library("lcms2")
        if not library:
            fail("LittleCMS 2 runtime library was not found")
        self.lib = ctypes.CDLL(library)
        pointer = ctypes.c_void_p
        self.error_handler_type = ctypes.CFUNCTYPE(
            None, pointer, ctypes.c_uint32, ctypes.c_char_p
        )

        @self.error_handler_type
        def error_handler(_context, code, message):
            text = message.decode("utf-8", errors="replace") if message else "unknown error"
            print(f"senemos-nabu-color-profile: LittleCMS[{code}]: {text}", file=sys.stderr)

        self.error_handler = error_handler
        self.lib.cmsSetLogErrorHandler.argtypes = [self.error_handler_type]
        self.lib.cmsSetLogErrorHandler(self.error_handler)
        self.lib.cmsBuildGamma.argtypes = [pointer, ctypes.c_double]
        self.lib.cmsBuildGamma.restype = pointer
        self.lib.cmsFreeToneCurve.argtypes = [pointer]
        self.lib.cmsCreateRGBProfile.argtypes = [
            ctypes.POINTER(CmsCIExyY), ctypes.POINTER(CmsCIExyYTriple),
            ctypes.POINTER(pointer),
        ]
        self.lib.cmsCreateRGBProfile.restype = pointer
        self.lib.cmsSetProfileVersion.argtypes = [pointer, ctypes.c_double]
        self.lib.cmsSetHeaderRenderingIntent.argtypes = [pointer, ctypes.c_uint32]
        self.lib.cmsPipelineAlloc.argtypes = [pointer, ctypes.c_uint32, ctypes.c_uint32]
        self.lib.cmsPipelineAlloc.restype = pointer
        self.lib.cmsPipelineFree.argtypes = [pointer]
        self.lib.cmsStageAllocCLut16bit.argtypes = [
            pointer, ctypes.c_uint32, ctypes.c_uint32, ctypes.c_uint32,
            ctypes.POINTER(ctypes.c_uint16),
        ]
        self.lib.cmsStageAllocCLut16bit.restype = pointer
        self.lib.cmsStageAllocToneCurves.argtypes = [
            pointer, ctypes.c_uint32, ctypes.POINTER(pointer),
        ]
        self.lib.cmsStageAllocToneCurves.restype = pointer
        self.sampler_type = ctypes.CFUNCTYPE(
            ctypes.c_int,
            ctypes.POINTER(ctypes.c_uint16),
            ctypes.POINTER(ctypes.c_uint16),
            pointer,
        )
        self.lib.cmsStageSampleCLut16bit.argtypes = [
            pointer, self.sampler_type, pointer, ctypes.c_uint32,
        ]
        self.lib.cmsStageSampleCLut16bit.restype = ctypes.c_int
        self.lib.cmsPipelineInsertStage.argtypes = [pointer, ctypes.c_uint32, pointer]
        self.lib.cmsPipelineInsertStage.restype = ctypes.c_int
        self.lib.cmsWriteTag.argtypes = [pointer, ctypes.c_uint32, pointer]
        self.lib.cmsWriteTag.restype = ctypes.c_int
        self.lib.cmsMLUalloc.argtypes = [pointer, ctypes.c_uint32]
        self.lib.cmsMLUalloc.restype = pointer
        self.lib.cmsMLUsetASCII.argtypes = [
            pointer, ctypes.c_char_p, ctypes.c_char_p, ctypes.c_char_p,
        ]
        self.lib.cmsMLUsetASCII.restype = ctypes.c_int
        self.lib.cmsMLUfree.argtypes = [pointer]
        self.lib.cmsSaveProfileToFile.argtypes = [pointer, ctypes.c_char_p]
        self.lib.cmsSaveProfileToFile.restype = ctypes.c_int
        self.lib.cmsCloseProfile.argtypes = [pointer]

    def _write_text_tag(self, profile, tag, value):
        mlu = self.lib.cmsMLUalloc(None, 1)
        if not mlu:
            fail("LittleCMS could not allocate an ICC text tag")
        try:
            encoded = value.encode("utf-8")
            if not self.lib.cmsMLUsetASCII(mlu, b"en", b"US", encoded):
                fail("LittleCMS could not encode an ICC text tag")
            if not self.lib.cmsWriteTag(profile, signature(tag), mlu):
                fail(f"LittleCMS could not write ICC tag {tag}")
        finally:
            self.lib.cmsMLUfree(mlu)

    def create_profile(self, output, pipeline, description, copyright_text):
        white = CmsCIExyY(0.3127, 0.3290, 1.0)
        if pipeline.gamut == "srgb":
            primary_values = ((0.640, 0.330), (0.300, 0.600), (0.150, 0.060))
        else:
            primary_values = ((0.680, 0.320), (0.265, 0.690), (0.150, 0.060))
        primaries = CmsCIExyYTriple(*(
            CmsCIExyY(x, y, 1.0) for x, y in primary_values
        ))
        curves = (ctypes.c_void_p * 3)(
            *(self.lib.cmsBuildGamma(None, 2.2) for _ in range(3))
        )
        profile = self.lib.cmsCreateRGBProfile(
            ctypes.byref(white), ctypes.byref(primaries), curves
        )
        for curve in curves:
            self.lib.cmsFreeToneCurve(curve)
        if not profile:
            fail("LittleCMS could not create the base display profile")
        lut_pipeline = None
        try:
            self.lib.cmsSetProfileVersion(profile, 4.3)
            self.lib.cmsSetHeaderRenderingIntent(profile, 1)
            lut_pipeline = self.lib.cmsPipelineAlloc(None, 3, 3)
            stage = self.lib.cmsStageAllocCLut16bit(None, 33, 3, 3, None)
            if not lut_pipeline or not stage:
                fail("LittleCMS could not allocate the ICC 3D LUT")

            identity_curves = (ctypes.c_void_p * 3)(
                *(self.lib.cmsBuildGamma(None, 1.0) for _ in range(3))
            )
            input_stage = self.lib.cmsStageAllocToneCurves(None, 3, identity_curves)
            output_stage = self.lib.cmsStageAllocToneCurves(None, 3, identity_curves)
            for curve in identity_curves:
                self.lib.cmsFreeToneCurve(curve)
            if not input_stage or not output_stage:
                fail("LittleCMS could not allocate ICC identity curves")

            @self.sampler_type
            def sampler(input_values, output_values, _cargo):
                source = tuple(input_values[index] / 65535.0 for index in range(3))
                result = pipeline.evaluate_icc_xyz(source)
                for index in range(3):
                    output_values[index] = round(clamp(result[index]) * 65535.0)
                return 1

            if not self.lib.cmsStageSampleCLut16bit(stage, sampler, None, 0):
                fail("LittleCMS could not sample the ICC 3D LUT")
            if not self.lib.cmsPipelineInsertStage(lut_pipeline, 1, input_stage):
                fail("LittleCMS could not insert the ICC input curves")
            if not self.lib.cmsPipelineInsertStage(lut_pipeline, 1, stage):
                fail("LittleCMS could not insert the ICC 3D LUT")
            if not self.lib.cmsPipelineInsertStage(lut_pipeline, 1, output_stage):
                fail("LittleCMS could not insert the ICC output curves")
            for tag in ("B2A0", "B2A1"):
                if not self.lib.cmsWriteTag(profile, signature(tag), lut_pipeline):
                    fail(f"LittleCMS could not write {tag}")
            self._write_text_tag(profile, "desc", description)
            self._write_text_tag(profile, "cprt", copyright_text)
            self._write_text_tag(profile, "dmnd", "Xiaomi / Qualcomm factory data")
            self._write_text_tag(profile, "dmdd", "Xiaomi Pad 5 (nabu)")
            if not self.lib.cmsSaveProfileToFile(profile, os.fsencode(output)):
                fail(f"LittleCMS could not save {output}")
        finally:
            if lut_pipeline:
                self.lib.cmsPipelineFree(lut_pipeline)
            self.lib.cmsCloseProfile(profile)


def load_database(path):
    try:
        tree = ET.parse(path)
    except (OSError, ET.ParseError) as error:
        fail(f"QDCM XML could not be read: {error}")
    match = PANEL_RE.search(Path(path).stem)
    if not match:
        fail("unsupported panel filename; expected Xiaomi 36_02_0b or 42_02_0a QDCM XML")
    panel = match.group(1).replace("_", "-")
    modes = {mode.get("Name"): mode for mode in tree.findall(".//Mode")}
    expected = {
        "hal_srgb": ("3", "srgb"),
        "hal_dci_p3": ("36", "dcip3"),
    }
    for android_name, _, _ in SUPPORTED_MODES.values():
        if android_name not in modes:
            fail(f"QDCM XML is missing required mode {android_name}")
        mode = modes[android_name]
        mode_id, gamut = expected[android_name]
        if (mode.get("ModeID") != mode_id or mode.get("ColorGamut") != gamut
                or mode.get("DynamicRange") != "sdr"):
            fail(f"QDCM mode {android_name} metadata is not the expected Nabu SDR mode")
    return panel, modes


def import_profiles(source, output_dir):
    source = Path(source).resolve()
    panel, modes = load_database(source)
    output_dir = Path(output_dir).expanduser().resolve()
    output_dir.mkdir(mode=0o755, parents=True, exist_ok=True)
    cms = LittleCms()
    source_hash = hashlib.sha256(source.read_bytes()).hexdigest()
    generated = []
    for profile_name, (android_name, gamut, label) in SUPPORTED_MODES.items():
        pipeline = QdcmPipeline(modes[android_name], gamut)
        filename = f"xiaomi-nabu-{panel}-{profile_name}.icc"
        destination = output_dir / filename
        description = f"Xiaomi Pad 5 {panel} - {label} (factory-derived, experimental)"
        copyright_text = (
            "Generated locally from user-supplied Qualcomm factory calibration; "
            "the source XML is not redistributed."
        )
        with tempfile.NamedTemporaryFile(dir=output_dir, prefix=f".{filename}.", delete=False) as tmp:
            temporary = Path(tmp.name)
        try:
            cms.create_profile(temporary, pipeline, description, copyright_text)
            temporary.chmod(0o644)
            temporary.replace(destination)
        finally:
            temporary.unlink(missing_ok=True)
        generated.append(destination)
        validate_icc(destination)
    manifest = output_dir / f"xiaomi-nabu-{panel}-source.sha256"
    manifest.write_text(f"{source_hash}  {source.name}\n", encoding="ascii")
    manifest.chmod(0o644)
    for path in generated:
        print(path)
    print(f"source-manifest={manifest}")


def icc_tags(data):
    if len(data) < 132 or int.from_bytes(data[0:4], "big") != len(data):
        fail("ICC size header is invalid")
    if data[12:16] != b"mntr" or data[16:20] != b"RGB " or data[20:24] != b"XYZ ":
        fail("ICC is not an RGB/XYZ display profile")
    if data[36:40] != b"acsp":
        fail("ICC magic is invalid")
    count = int.from_bytes(data[128:132], "big")
    if len(data) < 132 + count * 12:
        fail("ICC tag table is truncated")
    tags = {}
    for index in range(count):
        base = 132 + index * 12
        name = data[base:base + 4].decode("ascii", errors="replace")
        offset = int.from_bytes(data[base + 4:base + 8], "big")
        size = int.from_bytes(data[base + 8:base + 12], "big")
        if offset + size > len(data):
            fail(f"ICC tag {name} points outside the file")
        tags[name] = data[offset:offset + size]
    return tags


def validate_icc(path, quiet=False):
    path = Path(path).expanduser().resolve()
    try:
        data = path.read_bytes()
    except OSError as error:
        fail(f"ICC could not be read: {error}")
    tags = icc_tags(data)
    required = {"wtpt", "rXYZ", "gXYZ", "bXYZ", "rTRC", "gTRC", "bTRC", "B2A0", "B2A1", "desc"}
    missing = sorted(required - tags.keys())
    if missing:
        fail(f"ICC is missing required tags: {', '.join(missing)}")
    for name in ("B2A0", "B2A1"):
        tag = tags[name]
        if len(tag) < 32 or tag[0:4] != b"mBA ":
            fail(f"ICC {name} is not a LutBToA pipeline")
        clut_offset = int.from_bytes(tag[24:28], "big")
        if clut_offset == 0 or len(tag) < clut_offset + 20:
            fail(f"ICC {name} has no valid CLUT")
        if tag[clut_offset:clut_offset + 3] != bytes((33, 33, 33)):
            fail(f"ICC {name} is not a 33x33x33 CLUT")
    if not quiet:
        digest = hashlib.sha256(data).hexdigest()
        print(f"valid-icc={path}")
        print(f"sha256={digest}")


def find_profile(profile_name, panel, profile_dir):
    profile_dir = Path(profile_dir).expanduser().resolve()
    panel_pattern = panel if panel else "*"
    matches = sorted(profile_dir.glob(f"xiaomi-nabu-{panel_pattern}-{profile_name}.icc"))
    if len(matches) != 1:
        detail = "none" if not matches else ", ".join(path.name for path in matches)
        fail(f"exactly one matching profile is required; found: {detail}; use --panel")
    validate_icc(matches[0], quiet=True)
    return matches[0]


def read_output_state(doctor):
    try:
        result = subprocess.run(
            [doctor, "--json"], check=True, capture_output=True, text=True, timeout=10
        )
        document = json.loads(result.stdout)
    except (OSError, subprocess.SubprocessError, ValueError) as error:
        raise RuntimeError(f"KScreen output state could not be read: {error}") from error
    return document


def find_internal_output_state(document, requested):
    candidates = [
        output for output in document.get("outputs", [])
        if output.get("connected") and output.get("enabled")
        and str(output.get("name", "")).startswith("DSI-")
    ]
    if requested:
        candidates = [output for output in candidates if output.get("name") == requested]
    elif any(output.get("name") == "DSI-1" for output in candidates):
        candidates = [output for output in candidates if output.get("name") == "DSI-1"]
    if len(candidates) != 1:
        raise RuntimeError("exactly one enabled internal DSI output was not found")
    return candidates[0]


def find_internal_output(doctor, requested):
    try:
        return find_internal_output_state(read_output_state(doctor), requested)["name"]
    except RuntimeError as error:
        fail(str(error))


def apply_profile(profile_name, panel, profile_dir, output, dry_run):
    path = find_profile(profile_name, panel, profile_dir)
    doctor = os.environ.get("KSCREEN_DOCTOR", "/usr/bin/kscreen-doctor")
    connector = find_internal_output(doctor, output)
    settings = [
        f"output.{connector}.iccprofile.{path}",
        f"output.{connector}.colorProfileSource.ICC",
    ]
    if dry_run:
        print(f"connector={connector}")
        print(f"profile={path}")
        print("color-profile-source=ICC")
        return
    try:
        subprocess.run([doctor, *settings], check=True, timeout=15)
    except (OSError, subprocess.SubprocessError) as error:
        fail(f"ICC profile could not be applied: {error}")
    print(f"applied={path}")
    print(f"connector={connector}")


def panel_revision_paths():
    explicit = os.environ.get("SENEMOS_NABU_PANEL_REVISION_PATHS")
    if explicit:
        return [Path(path) for path in explicit.split(os.pathsep) if path]
    pattern = os.environ.get(
        "SENEMOS_NABU_PANEL_REVISION_GLOB", PANEL_REVISION_GLOB
    )
    return [Path(path) for path in sorted(glob.glob(pattern))]


def panel_efivar_paths():
    explicit = os.environ.get("SENEMOS_NABU_PANEL_EFIVAR_PATHS")
    if explicit:
        return [Path(path) for path in explicit.split(os.pathsep) if path]
    pattern = os.environ.get(
        "SENEMOS_NABU_PANEL_EFIVAR_GLOB", PANEL_EFIVAR_GLOB
    )
    return [Path(path) for path in sorted(glob.glob(pattern))]


def unique_panel_revision(revisions, source):
    if len(revisions) > 1:
        fail(
            f"conflicting Nabu panel revisions were reported by {source}: "
            f"{', '.join(sorted(revisions))}"
        )
    return next(iter(revisions), None)


def detect_panel_revision(paths=None, efivar_paths=None):
    revisions = set()
    for path in panel_revision_paths() if paths is None else paths:
        try:
            revision = Path(path).read_text(encoding="ascii").strip().lower()
        except OSError:
            continue
        if revision in PANEL_REVISIONS:
            revisions.add(revision)
    revision = unique_panel_revision(revisions, "kernel sysfs")
    if revision is not None:
        return revision

    # Kernel 7.2.4-3 and newer export panel_revision directly. Keep this
    # read-only UEFI fallback for installed fallback kernels so graphical login
    # never waits tens of seconds for an attribute that cannot appear.
    revisions.clear()
    for path in panel_efivar_paths() if efivar_paths is None else efivar_paths:
        try:
            payload = Path(path).read_bytes()[4:]
        except OSError:
            continue
        revisions.update(
            match.decode("ascii").replace("_", "-")
            for match in PANEL_EFIVAR_RE.findall(payload.lower())
        )
    return unique_panel_revision(revisions, "UEFI panel configuration")


def wait_for_panel_revision(retries, retry_delay):
    for attempt in range(max(1, retries)):
        panel = detect_panel_revision()
        if panel is not None:
            return panel
        if attempt + 1 < max(1, retries):
            time.sleep(max(0.0, retry_delay))
    return None


def normalize_profile_source(value):
    if isinstance(value, int):
        return {0: "sRGB", 1: "ICC", 2: "EDID"}.get(value)
    if isinstance(value, str):
        return {"srgb": "sRGB", "icc": "ICC", "edid": "EDID"}.get(value.lower())
    return None


def packaged_profile(path, profile_dir):
    if not path:
        return None
    candidate = Path(path).expanduser()
    try:
        if candidate.resolve().parent != Path(profile_dir).expanduser().resolve():
            return None
    except OSError:
        return None
    match = PACKAGED_PROFILE_RE.fullmatch(candidate.name)
    return match.groups() if match else None


def default_marker_path():
    state_home = Path(
        os.environ.get("XDG_STATE_HOME", Path.home() / ".local" / "state")
    )
    return state_home / "senemos-nabu" / "color-profile-auto.json"


def read_marker(path):
    try:
        marker = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None
    return marker if marker.get("version") == 1 else None


def write_marker(path, panel, profile, managed):
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    payload = {
        "version": 1,
        "panel": panel,
        "profile": profile,
        "managed": managed,
    }
    with tempfile.NamedTemporaryFile(
        mode="w", encoding="utf-8", dir=path.parent,
        prefix=f".{path.name}.", delete=False,
    ) as stream:
        json.dump(payload, stream, sort_keys=True)
        stream.write("\n")
        temporary = Path(stream.name)
    try:
        temporary.chmod(0o600)
        temporary.replace(path)
    finally:
        temporary.unlink(missing_ok=True)


def wait_for_internal_output(doctor, requested, retries, retry_delay):
    last_error = None
    for attempt in range(max(1, retries)):
        try:
            return find_internal_output_state(read_output_state(doctor), requested)
        except RuntimeError as error:
            last_error = error
            if attempt + 1 < max(1, retries):
                time.sleep(max(0.0, retry_delay))
    fail(str(last_error))


def auto_profile(profile_dir, output, marker_path, retries, retry_delay, dry_run):
    panel = wait_for_panel_revision(retries, retry_delay)
    if panel is None:
        print("auto=deferred")
        print("reason=panel-revision-unavailable")
        return

    profile_dir = Path(profile_dir).expanduser().resolve()
    marker_path = Path(marker_path).expanduser()
    doctor = os.environ.get("KSCREEN_DOCTOR", "/usr/bin/kscreen-doctor")
    state = wait_for_internal_output(doctor, output, retries, retry_delay)
    connector = state["name"]
    source = normalize_profile_source(state.get("colorProfileSource"))
    current_path = state.get("iccProfilePath") or ""
    current_packaged = packaged_profile(current_path, profile_dir)
    marker = read_marker(marker_path)

    # A packaged profile is ours to keep variant-correct, while retaining the
    # user's chosen gamut. A custom ICC, EDID source, or post-install switch
    # back to sRGB is a deliberate user choice and must never be overwritten.
    if source == "ICC" and current_packaged:
        profile_name = current_packaged[1]
    elif marker is None and source in (None, "sRGB"):
        profile_name = "srgb"
    elif (marker and marker.get("managed") and source is None
          and current_path == marker.get("profile") and current_packaged):
        profile_name = current_packaged[1]
    else:
        if not dry_run:
            write_marker(marker_path, panel, current_path, False)
        print("auto=preserved")
        print(f"connector={connector}")
        print(f"color-profile-source={source or 'unknown'}")
        if current_path:
            print(f"profile={current_path}")
        return

    path = find_profile(profile_name, panel, profile_dir)
    settings = [
        f"output.{connector}.iccprofile.{path}",
        f"output.{connector}.colorProfileSource.ICC",
    ]
    if dry_run:
        print("auto=would-apply")
    elif source != "ICC" or Path(current_path).expanduser() != path:
        try:
            subprocess.run([doctor, *settings], check=True, timeout=15)
        except (OSError, subprocess.SubprocessError) as error:
            fail(f"automatic ICC profile could not be applied: {error}")
        print("auto=applied")
    else:
        print("auto=current")
    if not dry_run:
        write_marker(marker_path, panel, str(path), True)
    print(f"panel={panel}")
    print(f"connector={connector}")
    print(f"profile={path}")
    print("color-profile-source=ICC")


def show_catalog():
    print("supported:")
    print("  srgb        Android hal_srgb (ModeID 3), SDR, static")
    print("  display-p3  Android hal_dci_p3 (ModeID 36), SDR, static")
    print("not-converted:")
    print("  native      panel primaries are absent from QDCM metadata")
    print("  smart_MC    dynamic/content-aware behavior is not an ICC profile")
    print("  GM_*/video* Qualcomm PA-v2 operations are not faithfully representable")
    print("  hal_hdr     Android HDR metadata/tone mapping is not an SDR ICC profile")


def main():
    parser = argparse.ArgumentParser(
        description="Generate Linux ICC v4 profiles from an authorized Xiaomi Nabu QDCM XML"
    )
    subparsers = parser.add_subparsers(dest="command", required=True)
    subparsers.add_parser("catalog", help="show supported and intentionally excluded modes")
    importer = subparsers.add_parser("import", help="generate user-local ICC profiles")
    importer.add_argument("xml", help="authorized qdcm_calib_data_xiaomi_*.xml path")
    importer.add_argument(
        "--output-dir",
        default=Path.home() / ICC_ROOT,
        help="destination (default: ~/.local/share/icc/senemos/nabu)",
    )
    validator = subparsers.add_parser("validate", help="validate an ICC for the KWin path")
    validator.add_argument("icc")
    applier = subparsers.add_parser("apply", help="apply a generated SDR profile with KScreen")
    applier.add_argument("profile", choices=sorted(SUPPORTED_MODES))
    applier.add_argument("--panel", choices=("36-02-0b", "42-02-0a"))
    applier.add_argument("--profile-dir", default=Path.home() / ICC_ROOT)
    applier.add_argument("--output", help="internal DSI connector; defaults to DSI-1")
    applier.add_argument("--dry-run", action="store_true")
    automatic = subparsers.add_parser(
        "auto", help="select the packaged sRGB ICC matching the detected panel"
    )
    automatic.add_argument("--profile-dir", default=SYSTEM_ICC_ROOT)
    automatic.add_argument("--output", help="internal DSI connector; defaults to DSI-1")
    automatic.add_argument("--marker", default=default_marker_path())
    automatic.add_argument("--retries", type=int, default=1)
    automatic.add_argument("--retry-delay", type=float, default=1.0)
    automatic.add_argument("--dry-run", action="store_true")
    arguments = parser.parse_args()
    if arguments.command == "catalog":
        show_catalog()
    elif arguments.command == "import":
        import_profiles(arguments.xml, arguments.output_dir)
    elif arguments.command == "validate":
        validate_icc(arguments.icc)
    elif arguments.command == "apply":
        apply_profile(
            arguments.profile, arguments.panel, arguments.profile_dir,
            arguments.output, arguments.dry_run,
        )
    else:
        auto_profile(
            arguments.profile_dir, arguments.output, arguments.marker,
            arguments.retries, arguments.retry_delay, arguments.dry_run,
        )


if __name__ == "__main__":
    main()
