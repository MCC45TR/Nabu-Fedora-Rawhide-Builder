#!/usr/bin/bash
set -Eeuo pipefail
PATH=/usr/sbin:/usr/bin
export PATH

exec 9>/run/nabu-package-management.lock
flock -n 9 || {
    printf 'Another Nabu package or UKI operation is active; retrying later.\n'
    exit 0
}

if [[ -r /sys/firmware/devicetree/base/compatible ]] &&
   ! grep -aq 'xiaomi,nabu' /sys/firmware/devicetree/base/compatible; then
    printf 'This is not a Xiaomi Pad 5 (nabu); skipping maintenance.\n'
    exit 0
fi

declare -A selector=(
    [alpha]=senemos-nabu-kernel-alpha
    [stable]=senemos-nabu-kernel
    [mainline]=senemos-nabu-kernel-mainline-alpha
    [lts]=senemos-nabu-kernel-lts
)
declare -A core=(
    [alpha]=senemos-nabu-kernel-alpha-core
    [stable]=senemos-nabu-kernel-core
    [mainline]=senemos-nabu-kernel-mainline-alpha-core
    [lts]=senemos-nabu-kernel-lts-core
)

preferred=alpha
if [[ -r /etc/nabu/kernel.conf ]]; then
    configured=$(sed -nE 's/^preferred=(alpha|stable|mainline|lts)$/\1/p' /etc/nabu/kernel.conf | tail -n1)
    [[ -n $configured ]] && preferred=$configured
fi

installed=()
for family in alpha stable mainline lts; do
    rpm -q "${selector[$family]}" >/dev/null 2>&1 && installed+=("$family")
done
[[ ${#installed[@]} -ge 1 ]] || {
    printf 'No Nabu kernel family is installed.\n' >&2
    exit 2
}

if ! rpm -q "${selector[$preferred]}" >/dev/null 2>&1; then
    preferred=${installed[0]}
    printf 'Configured family is absent; using installed family %s.\n' "$preferred"
fi

if [[ ${1:-} != --prepare-only ]]; then
    packages=()
    for family in "${installed[@]}"; do
        packages+=("${selector[$family]}")
    done
    dnf5 --assumeyes --refresh upgrade "${packages[@]}"
fi

latest_core=$(rpm -q --last "${core[$preferred]}" | sed -n '1s/[[:space:]].*//p')
[[ -n $latest_core ]] || {
    printf 'No installed kernel core package was found for %s.\n' "$preferred" >&2
    exit 3
}
mapfile -t kernels < <(rpm -ql "$latest_core" | sed -n 's@^/boot/vmlinuz-@@p')
[[ ${#kernels[@]} -eq 1 ]] || {
    printf 'Expected exactly one RPM-owned kernel in %s.\n' "$latest_core" >&2
    exit 4
}
kernel=${kernels[0]}
[[ -s /boot/vmlinuz-$kernel && -d /usr/lib/modules/$kernel ]] || {
    printf 'Incomplete RPM-owned kernel payload: %s\n' "$kernel" >&2
    exit 5
}

pending=/var/lib/nabu-kernel-maintenance/pending-kernel
prepared=/var/lib/nabu-kernel-maintenance/prepared-kernel
install -d -m0755 /var/lib/nabu-kernel-maintenance

# The maintenance path may replace only the canonical Nabu entry.  Snapshot the
# user's current loader default plus the protected Android/fallback entries and
# their EFI payloads before regeneration, then prove that they did not change.
loader_conf=/boot/efi/loader/loader.conf
[[ -r $loader_conf ]] || {
    printf 'Loader configuration is missing or unreadable.\n' >&2
    exit 6
}
loader_default_before=$(sed -nE 's/^[[:space:]]*default[[:space:]]+([^#[:space:]]+).*$/\1/p' "$loader_conf" | tail -n1)
[[ -n $loader_default_before ]] || {
    printf 'Loader default is not explicit; refusing an unverifiable UKI change.\n' >&2
    exit 6
}
declare -A protected_entry_digest protected_efi_digest protected_efi_path
for protected in android.conf fallback.conf; do
    protected_path=/boot/efi/loader/entries/$protected
    [[ -r $protected_path ]] || {
        printf 'Protected boot entry is missing: %s\n' "$protected" >&2
        exit 7
    }
    protected_efi=$(sed -nE 's@^efi[[:space:]]+(/.*)@\1@p' "$protected_path" | head -n1)
    [[ -n $protected_efi && -s /boot/efi"$protected_efi" ]] || {
        printf 'Protected EFI payload is missing: %s\n' "$protected" >&2
        exit 8
    }
    protected_efi_path[$protected]=$protected_efi
    protected_entry_digest[$protected]=$(sha256sum "$protected_path" | cut -d' ' -f1)
    protected_efi_digest[$protected]=$(sha256sum /boot/efi"$protected_efi" | cut -d' ' -f1)
done

printf '%s\n' "$kernel" >"$pending"
/usr/bin/nabu-regenerate-uki "$kernel"

entry=/boot/efi/loader/entries/senemos.conf
efi_path=$(sed -nE 's@^efi[[:space:]]+(/.*)@\1@p' "$entry" | head -n1)
[[ -n $efi_path && -s /boot/efi"$efi_path" ]] || {
    printf 'Canonical entry does not reference a complete UKI.\n' >&2
    exit 6
}
for protected in android.conf fallback.conf; do
    protected_path=/boot/efi/loader/entries/$protected
    protected_efi=${protected_efi_path[$protected]}
    [[ -r $protected_path && -s /boot/efi"$protected_efi" ]] || {
        printf 'Protected boot artifact disappeared: %s\n' "$protected" >&2
        exit 7
    }
    [[ $(sha256sum "$protected_path" | cut -d' ' -f1) == "${protected_entry_digest[$protected]}" &&
       $(sha256sum /boot/efi"$protected_efi" | cut -d' ' -f1) == "${protected_efi_digest[$protected]}" ]] || {
        printf 'Protected boot artifact changed unexpectedly: %s\n' "$protected" >&2
        exit 8
    }
done
loader_default_after=$(sed -nE 's/^[[:space:]]*default[[:space:]]+([^#[:space:]]+).*$/\1/p' "$loader_conf" | tail -n1)
[[ $loader_default_after == "$loader_default_before" ]] || {
    printf 'Loader default changed unexpectedly (%s -> %s).\n' "$loader_default_before" "$loader_default_after" >&2
    exit 9
}
printf '%s\n' "$kernel" >"$prepared"
rm -f "$pending"
printf 'Prepared preferred %s kernel and UKI: %s (%s)\n' "$preferred" "$kernel" "$efi_path"
