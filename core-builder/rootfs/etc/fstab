# Nabu CORE has two independently flashed filesystem images.  The root entry
# guarantees a writable real root after dracut switch-root; the ESP entry makes
# rEFInd and kernel maintenance operate on the actual fastboot ESP partition.
PARTLABEL=linux  /          ext4  rw,relatime,x-systemd.growfs         0  1
LABEL=ESPNABU    /boot/efi  vfat  rw,umask=0077,nofail,x-systemd.device-timeout=5s  0  2
